  "rename · 1 · 15": "guarantee. Core/provider errors remain observable as"
  "rename · 1 · 16": "explained standard refusal."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiI3MDUwOGNiNy01N2FmLTQ3NDAtODc2NS1jYmYzZTY1OGQxNzQiLCJraW5kIjoiY29tcG9uZW50IiwibmFtZSI6Ikxhbmd1YWdlU2VydmVyQWRhcHRlciJ9
s_5614201455f9166e7220b9b8d5d5a4b3372ca67d94bd454446eadd9d79ceb25d: "«component»\nLanguageServerAdapter" {
  shape: class
  # expec-uml: 
  "construction(connection, sources, identities)": ""
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6ImZjYWZmZDM4LTNmZGUtNGFlNi1iNzZkLTE1ZGJkZWMxN2UwNSIsIm93bmVyIjoic181NjE0MjAxNDU1ZjkxNjZlNzIyMGI5YjhkNWQ1YTRiMzM3MmNhNjdkOTRiZDQ1NDQ0NmVhZGQ5ZDc5Y2ViMjVkIiwibmFtZSI6InN0YXJ0IiwicGFyYW1ldGVycyI6W119
  "start()": ""
  "Promises · start": ""
  "start · 1": "Register native LSP initialization and document events once,"
  "start · 1 · 2": "using TextDocuments to reconstruct incremental text. Feed"
  "start · 1 · 3": "actual open/change/close snapshots and versions to core"
  "start · 1 · 4": "DocumentAnalysis. Opening must check exactly once despite"
  "start · 1 · 5": "TextDocuments also emitting a content-change event. Core"
  "start · 1 · 6": "owns checking and version/lifetime policy; this adapter owns"
  "start · 1 · 7": "protocol registration and translation. Register standard LSP"
  "start · 1 · 8": "document diagnostic pull with inter-file dependencies and no"
  "start · 1 · 9": "workspace diagnostic enumeration, and negotiate UTF-16"
  "start · 1 · 10": "positions. Register standard LSP watched-file notifications"
  "start · 1 · 11": "for requested dependency URIs, including currently missing"
  "start · 1 · 12": "files, using native relative-pattern registration. Core"
  "start · 1 · 13": "chooses relevant invalidation; forward"
  "start · 1 · 14": "creation/change/deletion to sourceChanged. Reconcile"
  "start · 1 · 15": "capture-to-watch gaps by rechecking after each newly"
  "start · 1 · 16": "established registration. Retain registrations only for"
  "start · 1 · 17": "dependency URIs requested by current open entries, and"
  "start · 1 · 18": "dispose them when unneeded or on shutdown. Unsupported"
  "start · 1 · 19": "native watch capabilities remain an observable limitation"
  "start · 1 · 20": "rather than a promised live update. Do not scan or compile"
  "start · 1 · 21": "in the adapter. Register native preview"
  "start · 1 · 22": "selection/configuration notifications and forward them to"
  "start · 1 · 23": "one core OutputPreviews instance using its default shipped"
  "start · 1 · 24": "registrations. Its feedback emits only plain"
  "start · 1 · 25": "PreviewPublication values through the native channel. Do not"
  "start · 1 · 26": "construct another reader/compiler or inspect output models."
  "start · 1 · 27": "Advertise definitionProvider and register standard"
  "start · 1 · 28": "textDocument/definition once. Obtain the current"
  "start · 1 · 29": "TextDocuments snapshot, then delegate coordinate conversion"
  "start · 1 · 30": "and the query to SourceDefinitionAdapter with one core"
  "start · 1 · 31": "SourceNavigation. Missing/cancelled/currently unavailable"
  "start · 1 · 32": "documents return no location. The adapter never chooses"
  "start · 1 · 33": "targets or rechecks source. Advertise hoverProvider and"
  "start · 1 · 34": "register standard textDocument/hover once. Obtain the"
  "start · 1 · 35": "current TextDocuments snapshot and delegate to"
  "start · 1 · 36": "SourceHoverAdapter using one core SourceHover; missing,"
  "start · 1 · 37": "cancelled or unavailable snapshots return absence. Hover"
  "start · 1 · 38": "uses the same existing analysis publications as diagnostics"
  "start · 1 · 39": "and navigation, without another reader/compiler."
  "start · 2": "Advertise documentSymbolProvider and register standard"
  "start · 2 · 2": "textDocument/documentSymbol once. Use the existing current"
  "start · 2 · 3": "TextDocuments snapshot and delegate to one"
  "start · 2 · 4": "SourceOutlineAdapter with one core DocumentOutline. Missing,"
  "start · 2 · 5": "cancelled, disposed or currently unavailable documents have"
  "start · 2 · 6": "no outline. Preserve one shared DocumentAnalysis and its"
  "start · 2 · 7": "current source/version/lifetime; no extra analysis,"
  "start · 2 · 8": "declaration walk or project connection is created for this"
  "start · 2 · 9": "request."
  "start · 3": "Advertise completionProvider without trigger characters or"
  "start · 3 · 2": "resolve support and register standard"
  "start · 3 · 3": "textDocument/completion once. Use the actual current"
  "start · 3 · 4": "TextDocuments entry and delegate to one"
  "start · 3 · 5": "SourceCompletionAdapter with one core SourceCompletion."
  "start · 3 · 6": "Cancelled, missing or disposed requests return an empty"
  "start · 3 · 7": "list. Reuse the same existing DocumentAnalysis publication;"
  "start · 3 · 8": "do not parse, resolve, acquire, generate or construct a"
  "start · 3 · 9": "second analysis for completion."
  "start · 4": "Capture each existing saved preview-configuration"
  "start · 4 · 2": "notification's exact file/text/writable scalars or absence"
  "start · 4 · 3": "and advance an owned latest-notification identity. Forward"
  "start · 4 · 4": "that captured snapshot first to the same"
  "start · 4 · 5": "OutputPreviews.configurationChanged to invalidate old"
  "start · 4 · 6": "preview work and prepare selection/options, then to the same"
  "start · 4 · 7": "DocumentAnalysis.configurationChanged so its new reports"
  "start · 4 · 8": "drive that configuration. Recheck the notification identity"
  "start · 4 · 9": "and adapter lifetime between forwards: a synchronous newer"
  "start · 4 · 10": "notification or disposal from preview feedback prevents the"
  "start · 4 · 11": "older snapshot from restoring package facts. Preserve"
  "start · 4 · 12": "currentness after reentrant analysis/feedback as well. Keep"
  "start · 4 · 13": "selection withdrawal and saved-text behavior; native"
  "start · 4 · 14": "callback exceptions remain observable. Never validate JSON"
  "start · 4 · 15": "in this adapter or wait for a connected target before"
  "start · 4 · 16": "supplying authored package facts. Configuration changes"
  "start · 4 · 17": "refresh current semantic reports at unchanged editor"
  "start · 4 · 18": "versions through the one existing analysis; no second"
  "start · 4 · 19": "reader/compiler, native package inspection, installation,"
  "start · 4 · 20": "project capture, file scan or new report identity field is"
  "start · 4 · 21": "introduced."
  "start · 5": "Advertise referencesProvider and register standard"
  "start · 5 · 2": "textDocument/references once. Use the current TextDocuments"
  "start · 5 · 3": "snapshot and delegate to one SourceReferenceAdapter with one"
  "start · 5 · 4": "core SourceReferences, preserving"
  "start · 5 · 5": "context.includeDeclaration. Missing, cancelled, disposed or"
  "start · 5 · 6": "currently unavailable documents return no locations. A"
  "start · 5 · 7": "successful presentation returns only its standard Location"
  "start · 5 · 8": "list through LSP. Keep its captured coverage as a"
  "start · 5 · 9": "point-in-time snapshot with this request lifetime, exact"
  "start · 5 · 10": "native analysis resultId and URI/version. Through standard"
  "start · 5 · 11": "connection.window.showInformationMessage display 'Reference"
  "start · 5 · 12": "search covers captured sources only; workspace importers"
  "start · 5 · 13": "were not scanned.' with a 'Show coverage' action, without"
  "start · 5 · 14": "delaying the Location response until a user chooses. When"
  "start · 5 · 15": "that choice settles, recheck the same document"
  "start · 5 · 16": "lifetime/version, analysis resultId, request cancellation,"
  "start · 5 · 17": "disposal and latest search before presenting a second"
  "start · 5 · 18": "standard information message listing the actual coveredUris"
  "start · 5 · 19": "and prerequisite entries. Entry version alone cannot"
  "start · 5 · 20": "identify a replacement import report; stale/superseded"
  "start · 5 · 21": "choices do nothing. Keep native request failures observable."
  "start · 5 · 22": "No custom coverage protocol, QuickPick API, Inspection,"
  "start · 5 · 23": "NodeId or compiler model crosses transport. This search"
  "start · 5 · 24": "covers only the requester and reachable captured"
  "start · 5 · 25": "imports/includes, never reverse workspace importers or an"
  "start · 5 · 26": "undiscovered workspace."
  "start · 6": "Register exactly one standard prepareRename/rename handler"
  "start · 6 · 2": "and advertise renameProvider with prepareProvider only when"
  "start · 6 · 3": "the client supports WorkspaceEdit.documentChanges. Supply"
  "start · 6 · 4": "one core SourceRename with the existing DocumentSources, the"
  "start · 6 · 5": "explicitly injected SourceIdentities port, and a"
  "start · 6 · 6": "RenameWorkspace port adapting this server lifetime: current"
  "start · 6 · 7": "selected saved configuration notifications and current"
  "start · 6 · 8": "TextDocuments open .expec URI/text/version facts. Do not"
  "start · 6 · 9": "substitute unsaved JSON proposals or infer rename permission"
  "start · 6 · 10": "from metadata writable. Neither a connected generated-output"
  "start · 6 · 11": "target nor generation is required. The adapter never"
  "start · 6 · 12": "enumerates folders or composes models. Translate actual"
  "start · 6 · 13": "prepare/rename replies through SourceRenameAdapter; core"
  "start · 6 · 14": "owns all configured-entry acquisition, naming, collision,"
  "start · 6 · 15": "completeness and refusal policy. Refuse unsupported"
  "start · 6 · 16": "versioned-edit capability with an explanation instead of"
  "start · 6 · 17": "returning unversioned edits. Capture request document"
  "start · 6 · 18": "identity/version and configuration revision; suppress"
  "start · 6 · 19": "cancelled, superseded, closed or disposed responses. Dispose"
  "start · 6 · 20": "owned registrations once and keep errors observable."
  "start · 6 · 21": "Existing diagnostics, previews, definition, hover, outline,"
  "start · 6 · 22": "completion and references retain their contracts."
  # expec-uml: 
  "publish(source, version, report)": ""
  "Promises · publish": ""
  "publish · 1": "Preserve current scope findings separately from source"
  "publish · 1 · 2": "diagnostics. Show actual dependencyProblems through standard"
  "publish · 1 · 3": "visible LSP window warnings, including code/message and the"
  "publish · 1 · 4": "selected manifest or supplied-mapping JSON-path origin. Do"
  "publish · 1 · 5": "not invent source ranges for dependency origins or mutate"
  "publish · 1 · 6": "Compilation. Deduplicate unchanged warnings for the same"
  "publish · 1 · 7": "current saved configuration/finding so ordinary typing"
  "publish · 1 · 8": "cannot flood notifications; changed, invalid or withdrawn"
  "publish · 1 · 9": "configuration must not reuse an old warning as current"
  "publish · 1 · 10": "evidence. The same current report still reaches previews"
  "publish · 1 · 11": "before native projection."
  "publish · 2": "Retain real syntax and compiler errors whose primary source"
  "publish · 2 · 2": "URI matches this document in its current native pull cache."
  "publish · 2 · 3": "Foreign primary findings remain in the raw Compilation and"
  "publish · 2 · 4": "output log; an open imported document receives its own entry"
  "publish · 2 · 5": "analysis. Never attach a foreign primary range to the"
  "publish · 2 · 6": "requesting document. Convert each scalar range with the"
  "publish · 2 · 7": "captured text for that range's exact URI, including"
  "publish · 2 · 8": "cross-file related information. Preserve messages and codes."
  "publish · 2 · 9": "Keep nonlocated problems and deferred requirements"
  "publish · 2 · 10": "observable in the language-client output log without"
  "publish · 2 · 11": "inventing editor positions. Replace old feedback, including"
  "publish · 2 · 12": "an empty full report when findings clear. Give each accepted"
  "publish · 2 · 13": "publication an opaque analysis resultId; editor version"
  "publish · 2 · 14": "alone cannot identify changed imports. Request the SDK"
  "publish · 2 · 15": "diagnostic refresh after dependent feedback changes. Never"
  "publish · 2 · 16": "reparse, generate or make semantic decisions here. Forward"
  "publish · 2 · 17": "this same captured source/version/report to core"
  "publish · 2 · 18": "OutputPreviews before reducing it to native diagnostic data;"
  "publish · 2 · 19": "preserve ordinary diagnostic publication and"
  "publish · 2 · 20": "dependency-watch behavior. Forward this same current"
  "publish · 2 · 21": "source/version/report to one core SourceNavigation before"
  "publish · 2 · 22": "native conversion. Forward this same current"
  "publish · 2 · 23": "source/version/report to one core SourceHover before native"
  "publish · 2 · 24": "conversion, including same-version replacement reports after"
  "publish · 2 · 25": "imported edits. No Inspection or Specification crosses the"
  "publish · 2 · 26": "protocol boundary."
  "publish · 3": "Forward the same current captured source/version/report to"
  "publish · 3 · 2": "DocumentOutline before answering native symbol requests. A"
  "publish · 3 · 3": "replacement or rejected report replaces its earlier tree"
  "publish · 3 · 4": "even at the same editor version; transport only plain native"
  "publish · 3 · 5": "symbols, never Inspection or a compiler model."
  "publish · 4": "Forward this same current captured source/version/report to"
  "publish · 4 · 2": "SourceCompletion before native conversion, including"
  "publish · 4 · 3": "same-version replacement after imported edits and rejected"
  "publish · 4 · 4": "reports that withdraw old completion facts. Transport only"
  "publish · 4 · 5": "plain native CompletionItems; Inspection and Resolution stay"
  "publish · 4 · 6": "within core."
  "publish · 5": "Forward this same current captured source/version/report to"
  "publish · 5 · 2": "SourceReferences before native reference conversion,"
  "publish · 5 · 3": "including same-version dependency replacements and rejected"
  "publish · 5 · 4": "reports. Do not create another reader, resolver, compiler,"
  "publish · 5 · 5": "file scan or reference model."
  # expec-uml: 
  "clear(uri)": ""
  "Promises · clear": ""
  "clear · 1": "Remove the closed document from the pull-response cache."
  "clear · 1 · 2": "Native document diagnostic pull owns editor close cleanup;"
  "clear · 1 · 3": "never resurrect a cached response from an earlier lifetime."
  "clear · 1 · 4": "Forward this closed URI to core OutputPreviews so pending"
  "clear · 1 · 5": "work and selected content from the closed lifetime are"
  "clear · 1 · 6": "withdrawn. End the same core SourceNavigation and"
  "clear · 1 · 7": "SourceHover report lifetimes through closed(uri)."
  "clear · 2": "End this same DocumentOutline lifetime through closed(uri);"
  "clear · 2 · 2": "later requests cannot use the closed document's tree."
  "clear · 3": "End this same SourceCompletion lifetime through closed(uri);"
  "clear · 3 · 2": "later completion requests cannot use its earlier facts."
  "clear · 4": "End this same SourceReferences lifetime through closed(uri)"
  "clear · 4 · 2": "and invalidate later coverage actions from that closed"
  "clear · 4 · 3": "lifetime. A visible summary is a historical snapshot, not a"
  "clear · 4 · 4": "claim of current coverage."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjVhOWE4Yzk2LTVjMGMtNDAxOC04MTJmLTk5OWU1ZGJkM2U5NyIsIm93bmVyIjoic181NjE0MjAxNDU1ZjkxNjZlNzIyMGI5YjhkNWQ1YTRiMzM3MmNhNjdkOTRiZDQ1NDQ0NmVhZGQ5ZDc5Y2ViMjVkIiwibmFtZSI6ImRpc3Bvc2UiLCJwYXJhbWV0ZXJzIjpbXX0
  "dispose()": ""
  "Promises · dispose": ""
  "dispose · 1": "Remove owned subscriptions, end tracked document lifetimes"
  "dispose · 1 · 2": "and prevent further diagnostic publication. Repeated"
  "dispose · 1 · 3": "disposal is harmless. Leave connection/process shutdown to"
  "dispose · 1 · 4": "the native server entry point. Dispose core OutputPreviews,"
  "dispose · 1 · 5": "invalidating pending output work; started renderer callbacks"
  "dispose · 1 · 6": "retain their own asynchronous cleanup obligation. Dispose"
  "dispose · 1 · 7": "SourceNavigation and its retained reports; later definition"
  "dispose · 1 · 8": "requests cannot use old targets. Dispose SourceHover; later"
  "dispose · 1 · 9": "hover requests cannot retain earlier meaning."
  "dispose · 2": "Release the owned document-symbol registration once and"
  "dispose · 2 · 2": "dispose DocumentOutline. Later callbacks cannot publish or"
  "dispose · 2 · 3": "return a retained tree."
  "dispose · 3": "Release the owned completion registration once and dispose"
  "dispose · 3 · 2": "SourceCompletion. Later callbacks cannot publish or return"
  "dispose · 3 · 3": "retained suggestions."
  "dispose · 4": "Release the owned reference registration and invalidate"
  "dispose · 4 · 2": "owned asynchronous coverage choices once, dispose"
  "dispose · 4 · 3": "SourceReferences and prevent later callbacks from returning"
  "dispose · 4 · 4": "old matches or presenting retained coverage."
}

  # expec-uml: 
  "construction(completion)": ""
  # expec-uml: 
  "items(document, position)": ""
  "Promises · items": ""
  "items · 1": "Convert this exact standard LSP TextDocument and zero-based"
  "items · 1 · 2": "UTF-16 Position to one current SourceCompletion query."
  "items · 1 · 3": "Invalid, fractional, negative, out-of-line or"
  "items · 1 · 4": "surrogate-interior positions give an empty list, never a"
  "items · 1 · 5": "clamped query. Require the reply's captured URI/text to"
  "items · 1 · 6": "match this document exactly and a finite single-line range"
  "items · 1 · 7": "containing this requested position. Return standard"
  "items · 1 · 8": "plain-text CompletionItems labelled by eligible spelling"
  "items · 1 · 9": "with an exact TextEdit for only the captured final token,"
  "items · 1 · 10": "using the SDK insertionText unchanged and actual targetName"
  "items · 1 · 11": "as plain detail. No inferred implementation or validity,"
  "items · 1 · 12": "snippets, command, additionalTextEdits, resolve handler,"
  "items · 1 · 13": "trusted Markdown or generated edits. Absence stays an empty"
  "items · 1 · 14": "list. This adapter owns coordinates and presentation, not"
  "items · 1 · 15": "scope, parsing, resolution, acquisition, generation or file"
  "items · 1 · 16": "mutation."
}

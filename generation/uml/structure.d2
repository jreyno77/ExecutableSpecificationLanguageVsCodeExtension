s_cec8b4967e8a673125f9313710a39939df91d337c8430aac391a45810a8c2cce: "«interface»\nDocumentSources" {
  shape: class
  # expec-uml: 
  "read(uri)": ""
  "Promises · read": ""
  "read · 1": "Return the current saved text with this exact URI, or"
  "read · 1 · 2": "absence when unavailable. Do not discover projects, install"
  "read · 1 · 3": "dependencies or substitute empty text. Unexpected"
  "read · 1 · 4": "acquisition errors surface. Core overrides this saved"
  "read · 1 · 5": "snapshot with an open document's unsaved text."
  # expec-uml: 
  "localPath(uri, manifestFile)": ""
  "Promises · localPath": ""
  "localPath · 1": "Return the verified portable source path relative to this"
  "localPath · 1 · 2": "selected manifest's directory, using the exact supplied"
  "localPath · 1 · 3": "source URI and native root/file ancestry facts. A named"
  "localPath · 1 · 4": "unsaved file under verified existing ancestors can have a"
  "localPath · 1 · 5": "path without reading or creating its contents. A foreign"
  "localPath · 1 · 6": "route, unsupported URI, unavailable root or route escaping"
  "localPath · 1 · 7": "the verified root has no local path; never strip a URI"
  "localPath · 1 · 8": "prefix or guess ownership from declarations, folders,"
  "localPath · 1 · 9": "generated destinations or build.sourceRoots. A nested source"
  "localPath · 1 · 10": "root cannot shorten the primary manifest-relative path. Core"
  "localPath · 1 · 11": "supplies its exact captured sourceId separately. Unexpected"
  "localPath · 1 · 12": "provider errors surface. This query does not scan, install,"
  "localPath · 1 · 13": "capture a connected project or write."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiI4YzVmMGEwMy0yZTBjLTRjNDItOGU3YS03YmFiNzNjYzgzNzIiLCJraW5kIjoiaW50ZXJmYWNlIiwibmFtZSI6IkRvY3VtZW50RmVlZGJhY2sifQ
s_b56bfd6f07bd5ea3b6a48016ef49d0a86ed88472899a5643905346a4c0d35265: "«interface»\nDocumentFeedback" {
  shape: class
  # expec-uml: 
  "publish(source, version, report)": ""
  "Promises · publish": ""
  "publish · 1": "Every DocumentAnalysis publication includes detached"
  "publish · 1 · 2": "immutable requirements and dependencyProblems lists prepared"
  "publish · 1 · 3": "through the public requirementsFor and ConfigurationReader."
  "publish · 1 · 4": "Keep the compiler Compilation unchanged; configuration and"
  "publish · 1 · 5": "source-ownership findings retain their actual dependency"
  "publish · 1 · 6": "origins separately. Output-profile findings unknown-output"
  "publish · 1 · 7": "and invalid-output-options with their actual manifest"
  "publish · 1 · 8": "outputs origins belong to the consumer's actual output"
  "publish · 1 · 9": "registry and are excluded from dependencyProblems; no"
  "publish · 1 · 10": "validated package catalog or scope rows are recovered from"
  "publish · 1 · 11": "that rejected configuration. Empty lists mean no effective"
  "publish · 1 · 12": "scoped obligations or findings, not proof of installation."
  "publish · 1 · 13": "The additive optional report fields support older"
  "publish · 1 · 14": "supplied-report consumers; this analysis always supplies"
  "publish · 1 · 15": "both. Caller mutation cannot change an earlier or current"
  "publish · 1 · 16": "report."
  "publish · 2": "Publish the report for this exact immutable snapshot and"
  "publish · 2 · 2": "version. Preserve actual reader diagnostics and the complete"
  "publish · 2 · 3": "compiler result, including nonlocated problems and deferred"
  "publish · 2 · 4": "requirements. Compilation is absent for rejected entry"
  "publish · 2 · 5": "syntax. Inspection is absent for rejected entry syntax;"
  "publish · 2 · 6": "otherwise it is a public QueryInspection over the same"
  "publish · 2 · 7": "SourceComposer Resolution.model passed to Compiler, captured"
  "publish · 2 · 8": "once without another resolution pass. It preserves bound,"
  "publish · 2 · 9": "invalid and deferred reference facts even when Compilation"
  "publish · 2 · 10": "has problems or no Specification. Never retain an older"
  "publish · 2 · 11": "Inspection after rejection. Sources are the captured texts"
  "publish · 2 · 12": "used for located findings; dependencies are exact source"
  "publish · 2 · 13": "URIs requested, including unavailable imports. An empty"
  "publish · 2 · 14": "diagnostic result replaces previous problems; absence of"
  "publish · 2 · 15": "problems alone does not establish compilation success."
  "publish · 3": "Retain that exact immutable SourceComposer Resolution in"
  "publish · 3 · 2": "this report, captured once and passed to Compiler and the"
  "publish · 3 · 3": "same QueryInspection before publication. Resolution is"
  "publish · 3 · 4": "absent for rejected entry syntax; never retain an earlier"
  "publish · 3 · 5": "accepted resolution after rejection. Current independently"
  "publish · 3 · 6": "bound facts remain usable despite unrelated compiler"
  "publish · 3 · 7": "problems or absent Specification. Completion consumes this"
  "publish · 3 · 8": "same core evidence without another resolution pass; no"
  "publish · 3 · 9": "Resolution or model crosses the native protocol boundary."
  # expec-uml: 
  "clear(uri)": ""
  "Promises · clear": ""
  "clear · 1": "Remove all diagnostic feedback for this exact document URI."
}

s_7b58d9f9fcf658a8bdc74ace8c3a623f475e9515eecd931be24568fca276336f: "«component»\nFileSources" {
  shape: class
  # expec-uml: 
  "read(uri)": ""
  "Promises · read": ""
  "read · 1": "Adapt a local file URI to its current UTF-8 saved text for"
  "read · 1 · 2": "DocumentSources. Missing files and unsupported URI schemes"
  "read · 1 · 3": "return absence. Other filesystem errors surface. Do not scan"
  "read · 1 · 4": "folders, acquire packages, cache business state or replace"
  "read · 1 · 5": "open editor text."
  # expec-uml: 
  "localPath(uri, manifestFile)": ""
  "Promises · localPath": ""
  "localPath · 1": "Adapt the exact file URI and selected absolute manifest"
  "localPath · 1 · 2": "filename into a verified primary manifest-directory-relative"
  "localPath · 1 · 3": "path through native path/ancestry identity APIs. Use"
  "localPath · 1 · 4": "portable / separators, preserve literal case/name, and never"
  "localPath · 1 · 5": "derive ownership by textual URI-prefix subtraction or from a"
  "localPath · 1 · 6": "generated target. Verify existing root/ancestors and"
  "localPath · 1 · 7": "ordinary file routes; a named unsaved file may use a"
  "localPath · 1 · 8": "verified existing parent without reading, creating or"
  "localPath · 1 · 9": "requiring its contents. Reject symlink escapes and alias"
  "localPath · 1 · 10": "routes that cannot establish the same source identity;"
  "localPath · 1 · 11": "unavailable or outside-root routes and nonfile/untitled URIs"
  "localPath · 1 · 12": "have no local path. A nested build.sourceRoots does not"
  "localPath · 1 · 13": "replace the primary root; an additional outside root cannot"
  "localPath · 1 · 14": "gain a guessed folder scope. Other filesystem errors"
  "localPath · 1 · 15": "surface. Core caches/invalidate these supplied facts; this"
  "localPath · 1 · 16": "native adapter adds no scope policy, configuration parser,"
  "localPath · 1 · 17": "whole-project discovery, installation or writes."
  # expec-uml: 
  "keyOf(uri, manifestFile)": ""
  "Promises · keyOf": ""
  "keyOf · 1": "Supply SourceIdentities from verified native physical file"
  "keyOf · 1 · 2": "facts under this selected primary manifest root. For an"
  "keyOf · 1 · 3": "existing ordinary file, return an opaque key whose equality"
  "keyOf · 1 · 4": "identifies the same physical file through supported"
  "keyOf · 1 · 5": "drive/URI spellings, filename-case aliases or hardlinks;"
  "keyOf · 1 · 6": "distinct physical files remain distinct even on a"
  "keyOf · 1 · 7": "case-sensitive filesystem. Verify root/ancestors and the"
  "keyOf · 1 · 8": "source identity before and after acquisition, reject"
  "keyOf · 1 · 9": "unsupported identities, escaping/symlink routes and changed"
  "keyOf · 1 · 10": "facts, and keep unexpected filesystem errors observable. A"
  "keyOf · 1 · 11": "never-saved named file or unavailable/unprovable physical"
  "keyOf · 1 · 12": "identity has no key; create nothing and allow the rename"
  "keyOf · 1 · 13": "caller to explain that saving is needed. Do not derive"
  "keyOf · 1 · 14": "identity from URI text, path case folding, canonical"
  "keyOf · 1 · 15": "pathname alone, source contents or a global cache. Preserve"
  "keyOf · 1 · 16": "localPath's literal scoped-path semantics. The key is"
  "keyOf · 1 · 17": "comparable only within this manifest/request and its final"
  "keyOf · 1 · 18": "recheck, never a durable ID or transport value. No folder"
  "keyOf · 1 · 19": "scan, parser, project capture, installation, save or"
  "keyOf · 1 · 20": "generation."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiJmZjkzNzM3NS1lZWRhLTQ1NTYtYTZhNC1kOTY3NGRmMWM1YzIiLCJraW5kIjoiY29tcG9uZW50IiwibmFtZSI6IkVkaXRvckxhbmd1YWdlU3VwcG9ydCJ9
s_9a5eb514b396ae71740452b876c21d0424c6ffb5f27357d723ada2d1c9d53026: "«component»\nEditorLanguageSupport" {
  shape: class
  # expec-uml: 
  "construction(context, client)": ""
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6ImMzMmQ2MjNkLWQ0YTQtNDBjMC05YTViLWVmNDU4OGUxNjE1ZiIsIm93bmVyIjoic185YTVlYjUxNGIzOTZhZTcxNzQwNDUyYjg3NmMyMWQwNDI0YzZmZmI1ZjI3MzU3ZDcyM2FkYTJkMWM5ZDUzMDI2IiwibmFtZSI6InN0YXJ0IiwicGFyYW1ldGVycyI6W119
  "start()": ""
  "Promises · start": ""
  "start · 1": "Request startup of the supplied native LanguageClient once."
  "start · 1 · 2": "The native entry point owns its construction, packaged"
  "start · 1 · 3": "TypeScript server, expec selector (file and untitled), and"
  "start · 1 · 4": "single awaited stop on deactivation. Return that native"
  "start · 1 · 5": "client through the standard VS Code activation export for"
  "start · 1 · 6": "callers of its native feature APIs. Register owned resources"
  "start · 1 · 7": "with this extension context. Use native document diagnostic"
  "start · 1 · 8": "pull on edits. In the public provideDiagnostics middleware"
  "start · 1 · 9": "capture native document identity/version before awaiting"
  "start · 1 · 10": "next, then cancel an obsolete/closed result instead of"
  "start · 1 · 11": "returning empty success. The SDK owns scheduling,"
  "start · 1 · 12": "cancellation and diagnostic collections. Never replace newer"
  "start · 1 · 13": "feedback or reopen diagnostics for a closed document; do not"
  "start · 1 · 14": "rely on push version fields. Guard public provideDefinition"
  "start · 1 · 15": "middleware with the requesting native document"
  "start · 1 · 16": "identity/version around its await, preserving prior"
  "start · 1 · 17": "middleware. Cancel obsolete, closed, disposed or cancelled"
  "start · 1 · 18": "requests rather than returning an old target. For returned"
  "start · 1 · 19": "target URIs already open when the request began, also refuse"
  "start · 1 · 20": "a result if that captured target buffer changed or ended its"
  "start · 1 · 21": "lifetime while awaiting. Core reports establish"
  "start · 1 · 22": "point-in-time meaning; this does not promise"
  "start · 1 · 23": "editor/filesystem atomicity across the process boundary."
  "start · 1 · 24": "Guard public provideHover middleware with requesting native"
  "start · 1 · 25": "document identity/version around its await, preserving prior"
  "start · 1 · 26": "middleware. Capture the requesting document and currently"
  "start · 1 · 27": "open expec buffer identities/versions before awaiting. After"
  "start · 1 · 28": "the prior middleware or next resolves, cancel if disposed,"
  "start · 1 · 29": "token-cancelled, or any captured buffer changed, closed or"
  "start · 1 · 30": "was replaced, since a hover reply does not identify its"
  "start · 1 · 31": "declaration source across the native boundary. Restore only"
  "start · 1 · 32": "this adapter's own middleware on disposal. This conservative"
  "start · 1 · 33": "pending-request guard does not claim filesystem/editor"
  "start · 1 · 34": "atomicity or replace core resolution policy. Keep startup"
  "start · 1 · 35": "failures observable and keep core policy out of this host"
  "start · 1 · 36": "adapter."
  "start · 2": "Guard standard provideDocumentSymbols middleware with the"
  "start · 2 · 2": "requesting native document identity/version around awaiting"
  "start · 2 · 3": "next. Preserve prior middleware and restore only the wrapper"
  "start · 2 · 4": "this adapter owns. Cancel an obsolete, closed, disposed or"
  "start · 2 · 5": "cancelled response rather than returning an old outline or"
  "start · 2 · 6": "invented empty success. Other unchanged documents remain"
  "start · 2 · 7": "usable. The native SDK owns the outline UI and scheduling;"
  "start · 2 · 8": "this adapter owns only native request currentness."
  "start · 3": "Guard the public provideCompletionItem middleware around"
  "start · 3 · 2": "awaiting the prior middleware or real continuation,"
  "start · 3 · 3": "preserving its exact replies. Capture the requesting"
  "start · 3 · 4": "document identity/version and currently open expec buffer"
  "start · 3 · 5": "identities/versions. Cancel a pending reply after requester"
  "start · 3 · 6": "or captured import-buffer change, close or replacement,"
  "start · 3 · 7": "token cancellation or disposal. Other-language buffer"
  "start · 3 · 8": "changes do not cancel completion. Release only this"
  "start · 3 · 9": "adapter's own wrapper. This protects a pending response; it"
  "start · 3 · 10": "does not promise editor/filesystem atomicity or safety when"
  "start · 3 · 11": "a user later chooses an already returned item. Core owns"
  "start · 3 · 12": "candidate policy and prepared facts."
  "start · 4": "Guard standard provideReferences middleware around awaiting"
  "start · 4 · 2": "its prior middleware or next, preserving the actual"
  "start · 4 · 3": "includeDeclaration context and returned locations. Capture"
  "start · 4 · 4": "the requesting document and all currently open expec buffer"
  "start · 4 · 5": "identities/versions; cancel if the requester or any captured"
  "start · 4 · 6": "buffer changed, closed or was replaced, or if"
  "start · 4 · 7": "disposed/token-cancelled. Preserve prior middleware and"
  "start · 4 · 8": "restore only this wrapper on disposal. The native"
  "start · 4 · 9": "LanguageClient handles standard server ShowMessageRequests"
  "start · 4 · 10": "for the visible bounded coverage summary/action; no separate"
  "start · 4 · 11": "coverage channel or business model is added here. Native SDK"
  "start · 4 · 12": "owns reference navigation and selection. This is a"
  "start · 4 · 13": "point-in-time report, not editor/filesystem atomicity; no"
  "start · 4 · 14": "native scans, saves or generation are added."
  "start · 5": "Guard the standard prepareRename and provideRenameEdits"
  "start · 5 · 2": "middleware around awaiting the previous middleware or real"
  "start · 5 · 3": "continuation. Preserve decoded newName and the exact native"
  "start · 5 · 4": "result; capture requesting document identity/version plus"
  "start · 5 · 5": "all currently open .expec buffer identities/versions. Cancel"
  "start · 5 · 6": "if a captured buffer changes, closes or is replaced, the"
  "start · 5 · 7": "request token is cancelled, the selected configuration"
  "start · 5 · 8": "notification revision changes, or this adapter is disposed."
  "start · 5 · 9": "Restore only owned wrappers and preserve prior middleware."
  "start · 5 · 10": "Standard VS Code owns rename input, preview/apply, optional"
  "start · 5 · 11": "preview selection and undo; never write files or claim"
  "start · 5 · 12": "atomicity after a returned response. No duplicate native"
  "start · 5 · 13": "edit application or generated-output invocation."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6ImNlN2VjNDkwLWUzMjYtNGRmYi1hOWJiLWQwODZiYTM5MDBmZCIsIm93bmVyIjoic185YTVlYjUxNGIzOTZhZTcxNzQwNDUyYjg3NmMyMWQwNDI0YzZmZmI1ZjI3MzU3ZDcyM2FkYTJkMWM5ZDUzMDI2IiwibmFtZSI6ImRpc3Bvc2UiLCJwYXJhbWV0ZXJzIjpbXX0
  "dispose()": ""
  "Promises · dispose": ""
  "dispose · 1": "Invalidate adapter-owned callbacks and remove owned"
  "dispose · 1 · 2": "registrations once. The native entry point owns the injected"
  "dispose · 1 · 3": "client and awaits its one stop promise on deactivation; this"
  "dispose · 1 · 4": "operation neither stops that client twice nor promises"
  "dispose · 1 · 5": "synchronous process termination."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiI1YmMxYjU3Yi03NGUwLTRhN2UtYWY0MS0yZWM2YWU0ZDgxY2UiLCJraW5kIjoiY29tcG9uZW50IiwibmFtZSI6Ik91dHB1dFByZXZpZXdIb3N0In0
s_3fee3d54dfbefd357cc01c0398d2b02b47c85363a8459073be41a33be54171c9: "«component»\nOutputPreviewHost" {
  shape: class
  # expec-uml: 
  "construction(context, client)": ""
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjY1ZjlkOTc2LWYwMmUtNGE4My1hNDM4LTk4ZDFhNDFiNDRjZiIsIm93bmVyIjoic18zZmVlM2Q1NGRmYmVmZDM1N2NjMDFjMDM5OGQyYjAyYjQ3Yzg1MzYzYTg0NTkwNzNiZTQxYTMzYmU1NDE3MWM5IiwibmFtZSI6InN0YXJ0IiwicGFyYW1ldGVycyI6W119
  "start()": ""
  "Promises · start": ""
  "start · 1": "Register Show Output Previews (expec.showOutputPreviews),"
  "start · 1 · 2": "the client notification handler and native editor-selection"
  "start · 1 · 3": "events once. Starting or activating the adapter registers"
  "start · 1 · 4": "the command without opening a panel. Invoking Show Output"
  "start · 1 · 5": "Previews creates or reveals one ordinary VS Code webview"
  "start · 1 · 6": "panel containing the packaged React OutputTabs application."
  "start · 1 · 7": "Its browser bootstrap mounts OutputTabs and uses the"
  "start · 1 · 8": "existing Vite/React build to bundle React and ReactDOM"
  "start · 1 · 9": "locally, not external runtime imports. Package the resulting"
  "start · 1 · 10": "script/style assets under dist/webview in the VSIX. Preserve"
  "start · 1 · 11": "the real shipped UML renderer SDK worker and WASM runtime,"
  "start · 1 · 12": "including its module-relative resources and paths, so"
  "start · 1 · 13": "packaged native server rendering works without a checkout or"
  "start · 1 · 14": "external runtime download. Browser asset build and native"
  "start · 1 · 15": "renderer resource packaging precede implementation testing."
  "start · 1 · 16": "Follow the current expec editor URI, including untitled;"
  "start · 1 · 17": "focusing the panel retains the last authored selection."
  "start · 1 · 18": "Forward selection to server core without reading or"
  "start · 1 · 19": "compiling documents. Subscribe before client startup and"
  "start · 1 · 20": "replay latest selected URI and saved configuration when the"
  "start · 1 · 21": "same client becomes running, including restart. The existing"
  "start · 1 · 22": "native client and diagnostic feature APIs remain intact."
  "start · 1 · 23": "Register owned resources in the supplied context; host"
  "start · 1 · 24": "lifetime guards only prevent disposed callbacks, not another"
  "start · 1 · 25": "business revision engine."
  # expec-uml: 
  "configurationChanged(configuration)": ""
  "Promises · configurationChanged": ""
  "configurationChanged · 1": "Forward this captured saved configuration snapshot, or"
  "configurationChanged · 1 · 2": "selection absence, to server core through the native client."
  "configurationChanged · 1 · 3": "Buffer the latest snapshot until the client is running. Do"
  "configurationChanged · 1 · 4": "not parse or validate it, infer target readiness, capture"
  "configurationChanged · 1 · 5": "project code, install packages or generate. Dirty"
  "configurationChanged · 1 · 6": "configuration behavior is supplied by ConnectionSidebar and"
  "configurationChanged · 1 · 7": "remains saved-text behavior."
  # expec-uml: 
  "present(publication)": ""
  "Promises · present": ""
  "present · 1": "Adapt one current plain core presentation to the webview"
  "present · 1 · 2": "message channel. Cache only the latest full presentation for"
  "present · 1 · 3": "ready replay, panel recreation and temporarily hidden"
  "present · 1 · 4": "panels; postMessage success is dispatch only, not proof of"
  "present · 1 · 5": "rendering. Never transport Specification, compiler models,"
  "present · 1 · 6": "functions or private ownership data. Set webview HTML once"
  "present · 1 · 7": "per lifetime, mount the bundled React application before"
  "present · 1 · 8": "ready, and replay to that exact live panel. Resolve only"
  "present · 1 · 9": "packaged local script/style assets with asWebviewUri and"
  "present · 1 · 10": "restrict localResourceRoots to their folder. Enable scripts"
  "present · 1 · 11": "only; disable forms and command URIs. Use a CSP beginning"
  "present · 1 · 12": "default-src none with only the bundled scripts/styles and"
  "present · 1 · 13": "required inert data images allowed. Literal text is never"
  "present · 1 · 14": "HTML and SVG is never injected inline or fetched from target"
  "present · 1 · 15": "paths. Present the core source context and whole-view"
  "present · 1 · 16": "explanation as well as its ordered tabs."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjBmNzM1NDAxLWIwNTUtNDVmMi05MjUzLWJjZDQ0MWVkOTViZSIsIm93bmVyIjoic18zZmVlM2Q1NGRmYmVmZDM1N2NjMDFjMDM5OGQyYjAyYjQ3Yzg1MzYzYTg0NTkwNzNiZTQxYTMzYmU1NDE3MWM5IiwibmFtZSI6ImRpc3Bvc2UiLCJwYXJhbWV0ZXJzIjpbXX0
  "dispose()": ""
  "Promises · dispose": ""
  "dispose · 1": "Dispose every owned panel, command and event/message"
  "dispose · 1 · 2": "subscription, attempt all cleanup even if one resource"
  "dispose · 1 · 3": "fails, and prevent later dispatch or selection/configuration"
  "dispose · 1 · 4": "events. Panel closure releases its webview only and does not"
  "dispose · 1 · 5": "stop language analysis; reopening receives the latest"
  "dispose · 1 · 6": "current presentation. The native entry point owns the"
  "dispose · 1 · 7": "supplied client and its one awaited stop."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiJiOGYzMmFkYS01MGQ5LTQ5ZDctOTg3NS01NzViMmVlMjJiMDgiLCJraW5kIjoiY29tcG9uZW50IiwibmFtZSI6IkNvbm5lY3Rpb25TaWRlYmFyIn0
s_7f2a437e56f2b14fadd087d0aa11cb11e04793adbae701e54a075f06d215f47e: "«component»\nConnectionSidebar" {
  shape: class
  # expec-uml: 
  "construction(context, previews)": ""
  # expec-uml: 
  "start(configurationFile)": ""
  "Promises · start": ""
  "start · 1": "Register the native .expec Project Connection view and"
  "start · 1 · 2": "legacy Choose Project command once. Contribute a dedicated"
  "start · 1 · 3": ".expec Activity Bar container with a packaged recognizable"
  "start · 1 · 4": "monochrome icon and move the existing expec.connection view"
  "start · 1 · 5": "into it, retaining its public view ID and actual registered"
  "start · 1 · 6": "TreeDataProvider. Supply discoverable New Connection and"
  "start · 1 · 7": "Edit Connection title actions, and row context actions Edit"
  "start · 1 · 8": "Connection, New Connection, Disconnect or Reconnect"
  "start · 1 · 9": "according to the actual state, and Delete Connection when"
  "start · 1 · 10": "project metadata exists. Use native commands"
  "start · 1 · 11": "expec.newConnection, expec.editConnection,"
  "start · 1 · 12": "expec.disconnectConnection, expec.reconnectConnection and"
  "start · 1 · 13": "expec.deleteConnection, with their declared activation and"
  "start · 1 · 14": "contextual menus. Adapt this same instance to standard"
  "start · 1 · 15": "TreeDataProvider APIs; native activation exposes that actual"
  "start · 1 · 16": "registered provider as connectionTreeProvider alongside the"
  "start · 1 · 17": "same native LanguageClient. Existing client identity and"
  "start · 1 · 18": "methods remain intact; no test-only core query or"
  "start · 1 · 19": "reconstructed test rows. Start core ConnectionController for"
  "start · 1 · 20": "the supplied absolute local manifest filename, feeding"
  "start · 1 · 21": "actual saved text or absence and whether the document can be"
  "start · 1 · 22": "written. Display checking until core verifies the"
  "start · 1 · 23": "connection. Legacy picking a folder sends its absolute"
  "start · 1 · 24": "fsPath to core; cancel does nothing. Switching filename"
  "start · 1 · 25": "withdraws work, disposes the previous controller and watches"
  "start · 1 · 26": "before following the new configuration; obsolete callbacks"
  "start · 1 · 27": "cannot affect the view or save a file. Attach any current"
  "start · 1 · 28": "work observer to the new controller. Settings"
  "start · 1 · 29": "expec.configurationFile defaults to expec.json relative to"
  "start · 1 · 30": "the selected workspace folder; a single folder can be"
  "start · 1 · 31": "selected automatically, multiple folders require a workspace"
  "start · 1 · 32": "choice. Empty/remote workspaces show an explanation and do"
  "start · 1 · 33": "not claim a connection. Opening the view or invoking a"
  "start · 1 · 34": "command activates the extension; opening an expec document"
  "start · 1 · 35": "still activates existing language support. Forward the"
  "start · 1 · 36": "actual selected saved ConnectionConfiguration snapshot to"
  "start · 1 · 37": "the supplied preview feedback whenever it changes,"
  "start · 1 · 38": "independently of target verification or session-only"
  "start · 1 · 39": "disconnect. Withdraw the prior preview selection with"
  "start · 1 · 40": "absence before switching manifests. Do not parse it again or"
  "start · 1 · 41": "wait for connected status to permit authored previews."
  # expec-uml: 
  "observeWork(feedback)": ""
  "Promises · observeWork": ""
  "observeWork · 1": "Attach one replaceable connection-owned work observer,"
  "observeWork · 1 · 2": "immediately forwarding to the current controller or"
  "observeWork · 1 · 3": "delivering absence if no controller exists. Replacing or"
  "observeWork · 1 · 4": "disposing the observer withdraws the prior one. Retain this"
  "observeWork · 1 · 5": "one observer across controller replacement while guarding"
  "observeWork · 1 · 6": "current selection, observer identity and native lifetime"
  "observeWork · 1 · 7": "around reentrant callbacks. Existing constructor and"
  "observeWork · 1 · 8": "metadata-only callers remain valid. Actual activation always"
  "observeWork · 1 · 9": "attaches its existing single GenerationHost here once; the"
  "observeWork · 1 · 10": "independent preview callback carries raw saved metadata to"
  "observeWork · 1 · 11": "previews and live package analysis but never generation. Do"
  "observeWork · 1 · 12": "not duplicate core connection or generation decisions."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjI4NGQ4NzA2LThiNTUtNDczNy1iZDY1LTdlZThiYTg3YjgzYiIsIm93bmVyIjoic183ZjJhNDM3ZTU2ZjJiMTRmYWRkMDg3ZDBhYTExY2IxMWUwNDc5M2FkYmFlNzAxZTU0YTA3NWYwNmQyMTVmNDdlIiwibmFtZSI6ImVkaXRDb25uZWN0aW9uIiwicGFyYW1ldGVycyI6W119
  "editConnection()": ""
  "Promises · editConnection": ""
  "editConnection · 1": "Open the actual selected local manifest in the ordinary VS"
  "editConnection · 1 · 2": "Code text editor. Preserve dirty text and do not save,"
  "editConnection · 1 · 3": "create a missing file or change metadata merely to edit it."
  "editConnection · 1 · 4": "If the selected file does not exist, explain that New"
  "editConnection · 1 · 5": "Connection can create it. Editing is the supported path for"
  "editConnection · 1 · 6": "advanced existing output options. Guard selected filename"
  "editConnection · 1 · 7": "and native lifetime around awaits."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6ImM5MWVlYTgxLTQ4OTItNGY5Yy1hNzY5LTdjNTQ1NjA0YTZhNSIsIm93bmVyIjoic183ZjJhNDM3ZTU2ZjJiMTRmYWRkMDg3ZDBhYTExY2IxMWUwNDc5M2FkYmFlNzAxZTU0YTA3NWYwNmQyMTVmNDdlIiwibmFtZSI6Im5ld0Nvbm5lY3Rpb24iLCJwYXJhbWV0ZXJzIjpbXX0
  "newConnection()": ""
  "Promises · newConnection": ""
  "newConnection · 1": "Guide an explicit author choice with standard VS Code folder"
  "newConnection · 1 · 2": "dialog, output QuickPick and destination InputBox steps; no"
  "newConnection · 1 · 3": "project-scaffolding wizard or custom webview. Obtain the"
  "newConnection · 1 · 4": "current plain ConnectionController.guidance result once"
  "newConnection · 1 · 5": "before choices; absence uses the existing invalid or"
  "newConnection · 1 · 6": "unavailable explanation and cannot start a proposal. Consume"
  "newConnection · 1 · 7": "its captured configuration, configured flags, eligible"
  "newConnection · 1 · 8": "output IDs, suggested destinations and requiresEntries,"
  "newConnection · 1 · 9": "rather than parsing saved JSON, registering output profiles"
  "newConnection · 1 · 10": "or reconstructing setup policy in the native adapter. Select"
  "newConnection · 1 · 11": "any usable empty or existing local target directory. Present"
  "newConnection · 1 · 12": "already configured output IDs, preserving their exact"
  "newConnection · 1 · 13": "options, and the core's eligible new choices. Explain that"
  "newConnection · 1 · 14": "advanced profiles can be retained or edited in the manifest"
  "newConnection · 1 · 15": "but are not initialized with guessed options. Preserve"
  "newConnection · 1 · 16": "authored selection order. Prompt an actual relative"
  "newConnection · 1 · 17": "destination only for a newly selected output, labelled"
  "newConnection · 1 · 18": "relative to the connected target, with the core-supplied"
  "newConnection · 1 · 19": "editable suggestion. Suggestions are extension setup policy,"
  "newConnection · 1 · 20": "not SDK defaults. Explain TypeScript folder mirroring from"
  "newConnection · 1 · 21": "the manifest's source folder; core supplies sourceRoot '.',"
  "newConnection · 1 · 22": "and the target-root suggestion avoids src/src duplication."
  "newConnection · 1 · 23": "Request real source entries only when"
  "newConnection · 1 · 24": "guidance.requiresEntries is true; existing metadata retains"
  "newConnection · 1 · 25": "build.entries and needs no new source prompt. For a missing"
  "newConnection · 1 · 26": "manifest use an actual saved ordinary .expec source within"
  "newConnection · 1 · 27": "its folder, or ask the author to select real .expec source"
  "newConnection · 1 · 28": "files within that folder, and pass their literal relative"
  "newConnection · 1 · 29": "entries; absent/cancelled source selection requests no"
  "newConnection · 1 · 30": "creation. Never assume src/main.expec exists or create an"
  "newConnection · 1 · 31": "authored entry. Capture the exact selected controller and"
  "newConnection · 1 · 32": "saved file/text/writable snapshot plus selection revision"
  "newConnection · 1 · 33": "and native lifetime before guidance; recheck after every"
  "newConnection · 1 · 34": "asynchronous choice and immediately before forwarding"
  "newConnection · 1 · 35": "core.createConnection. Cancellation at any step, selection"
  "newConnection · 1 · 36": "replacement, changed saved metadata, dirty configuration or"
  "newConnection · 1 · 37": "disposal cannot initiate a late write or change the old"
  "newConnection · 1 · 38": "selection. Core owns proposal validation, target"
  "newConnection · 1 · 39": "verification and persistence requests. Surface real refusals"
  "newConnection · 1 · 40": "and save failures; do not claim rollback, target"
  "newConnection · 1 · 41": "initialization, dependency readiness or generation success."
  "newConnection · 1 · 42": "Only the selected manifest may be created by the explicit"
  "newConnection · 1 · 43": "New Connection action."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjYwOTQ0OTQ5LTU3NTYtNDY5NS1iZWE4LTAzYzEzNjUyZDYyZiIsIm93bmVyIjoic183ZjJhNDM3ZTU2ZjJiMTRmYWRkMDg3ZDBhYTExY2IxMWUwNDc5M2FkYmFlNzAxZTU0YTA3NWYwNmQyMTVmNDdlIiwibmFtZSI6ImRpc2Nvbm5lY3QiLCJwYXJhbWV0ZXJzIjpbXX0
  "disconnect()": ""
  "Promises · disconnect": ""
  "disconnect · 1": "Forward the explicit session-only suspension to the current"
  "disconnect · 1 · 2": "core controller. Present its actual disconnected state and"
  "disconnect · 1 · 3": "explain that saved configuration and files are retained and"
  "disconnect · 1 · 4": "reconnection is available. The work observer withdraws"
  "disconnect · 1 · 5": "connection-owned generation; its prior per-manifest opt-in"
  "disconnect · 1 · 6": "is neither erased nor granted. Keep raw saved"
  "disconnect · 1 · 7": "preview/package configuration available. No metadata write"
  "disconnect · 1 · 8": "or target deletion."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjYwN2ExZWViLTM1ODUtNDU1ZS04MjU5LTA0NGQ0NTkzYjA3YyIsIm93bmVyIjoic183ZjJhNDM3ZTU2ZjJiMTRmYWRkMDg3ZDBhYTExY2IxMWUwNDc5M2FkYmFlNzAxZTU0YTA3NWYwNmQyMTVmNDdlIiwibmFtZSI6InJlY29ubmVjdCIsInBhcmFtZXRlcnMiOltdfQ
  "reconnect()": ""
  "Promises · reconnect": ""
  "reconnect · 1": "Forward the explicit resume to the current core controller"
  "reconnect · 1 · 2": "and show its real fresh verification outcome. Preserve prior"
  "reconnect · 1 · 3": "explicit per-manifest generation opt-in exactly; a"
  "reconnect · 1 · 4": "previously disabled connection stays disabled. Never start"
  "reconnect · 1 · 5": "generation, replay a previous save or save configuration"
  "reconnect · 1 · 6": "from reconnection. A later genuine source save is required"
  "reconnect · 1 · 7": "even if opt-in was previously true."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjQ3NTE1OTk4LWU2MmMtNDdmMC1iMTM2LWUyOGNkZDMxNzJiNyIsIm93bmVyIjoic183ZjJhNDM3ZTU2ZjJiMTRmYWRkMDg3ZDBhYTExY2IxMWUwNDc5M2FkYmFlNzAxZTU0YTA3NWYwNmQyMTVmNDdlIiwibmFtZSI6ImRlbGV0ZUNvbm5lY3Rpb24iLCJwYXJhbWV0ZXJzIjpbXX0
  "deleteConnection()": ""
  "Promises · deleteConnection": ""
  "deleteConnection · 1": "Ask for explicit native confirmation naming the selected"
  "deleteConnection · 1 · 2": "manifest and explaining that only its project metadata will"
  "deleteConnection · 1 · 3": "be removed, with target files, outputs and packages"
  "deleteConnection · 1 · 4": "retained. Cancellation changes nothing. Capture selected"
  "deleteConnection · 1 · 5": "controller and exact saved snapshot before prompting;"
  "deleteConnection · 1 · 6": "recheck selection, saved text, write safety and lifetime"
  "deleteConnection · 1 · 7": "before core.deleteConnection. Dirty configuration or changed"
  "deleteConnection · 1 · 8": "selection cannot delete another connection. Core owns the"
  "deleteConnection · 1 · 9": "conditional metadata proposal and actual confirmation. Do"
  "deleteConnection · 1 · 10": "not delete a manifest, source, generated artifact or target"
  "deleteConnection · 1 · 11": "directory."
  # expec-uml: 
  "present(state)": ""
  "Promises · present": ""
  "present · 1": "Translate the current core state into native TreeItem"
  "present · 1 · 2": "labels, description, tooltip and contextual command"
  "present · 1 · 3": "availability; do not validate configuration or decide"
  "present · 1 · 4": "connection policy. Use current core guidance.hasProject for"
  "present · 1 · 5": "Delete availability; a requested state.target alone does not"
  "present · 1 · 6": "prove saved project metadata exists. Show the actual target"
  "present · 1 · 7": "and explanation, including explicit session-only"
  "present · 1 · 8": "disconnected status. Make the actual selected manifest"
  "present · 1 · 9": "filename and full absolute path visible in the native view"
  "present · 1 · 10": "so the author can identify which metadata these commands"
  "present · 1 · 11": "affect; hidden provider fields alone do not satisfy this"
  "present · 1 · 12": "presentation. Connected means the configured directory has a"
  "present · 1 · 13": "verified filesystem identity, not that native build"
  "present · 1 · 14": "prerequisites or generation succeeded. Keep scoped native"
  "present · 1 · 15": "watches for the selected manifest and current"
  "present · 1 · 16": "logical/canonical target and their existing ancestors,"
  "present · 1 · 17": "including when a target is absent. Forward actual relevant"
  "present · 1 · 18": "configuration and target events to core, including creation,"
  "present · 1 · 19": "deletion and settings changes, without a manual Refresh"
  "present · 1 · 20": "action, polling, scanning or recursive project capture."
  "present · 1 · 21": "Dispose old watches when the target/configuration changes;"
  "present · 1 · 22": "changes at an old target cannot restore an obsolete state."
  "present · 1 · 23": "Register before reading and recheck once after registration;"
  "present · 1 · 24": "registration alone does not prove the operating-system"
  "present · 1 · 25": "watcher is ready. Surface watch failures rather than showing"
  "present · 1 · 26": "a stale healthy status."
  # expec-uml: 
  "saveConfiguration(previous, text)": ""
  "Promises · saveConfiguration": ""
  "saveConfiguration · 1": "Fulfill this exact current core save request using VS Code"
  "saveConfiguration · 1 · 2": "file/document APIs. Recheck the selected filename, current"
  "saveConfiguration · 1 · 3": "saved text and dirty-editor state immediately before"
  "saveConfiguration · 1 · 4": "applying; refuse stale requests or dirty documents without"
  "saveConfiguration · 1 · 5": "overwriting user edits. Save only the manifest selected by"
  "saveConfiguration · 1 · 6": "the author, preserve all other settings as supplied by core,"
  "saveConfiguration · 1 · 7": "and never write connected-project source. Confirm success to"
  "saveConfiguration · 1 · 8": "core with actual saved text, or report the failure using"
  "saveConfiguration · 1 · 9": "core.saveFailed with the exact previous snapshot. A"
  "saveConfiguration · 1 · 10": "requested write or picker result alone never proves success."
  "saveConfiguration · 1 · 11": "Missing manifests can be created only by explicit Choose"
  "saveConfiguration · 1 · 12": "Project or New Connection actions. Do not create projects,"
  "saveConfiguration · 1 · 13": "install packages, compile or generate outputs. Forward"
  "saveConfiguration · 1 · 14": "successful actual saved confirmation to the same preview"
  "saveConfiguration · 1 · 15": "feedback; dirty edits continue using saved bytes, not"
  "saveConfiguration · 1 · 16": "unsaved configuration text. Actual apply/save effects are"
  "saveConfiguration · 1 · 17": "not atomic and failures do not establish rollback."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjdkNWJhNjg3LTI1ZjYtNGE2ZC1iNTE4LTFhMmZjZTk0MWM0MyIsIm93bmVyIjoic183ZjJhNDM3ZTU2ZjJiMTRmYWRkMDg3ZDBhYTExY2IxMWUwNDc5M2FkYmFlNzAxZTU0YTA3NWYwNmQyMTVmNDdlIiwibmFtZSI6ImRpc3Bvc2UiLCJwYXJhbWV0ZXJzIjpbXX0
  "dispose()": ""
  "Promises · dispose": ""
  "dispose · 1": "Stop core and dispose every owned view, command, event"
  "dispose · 1 · 2": "subscription and watcher. Repeated disposal is harmless;"
  "dispose · 1 · 3": "pending reads, guidance, confirmations and saves cannot"
  "dispose · 1 · 4": "publish or initiate writes after disposal. Cleanup must"
  "dispose · 1 · 5": "attempt all owned resources even when one throws and"
  "dispose · 1 · 6": "preserve actual causes. Withdraw and release the work"
  "dispose · 1 · 7": "observer and selected preview configuration before releasing"
  "dispose · 1 · 8": "this native lifetime; the existing awaited GenerationHost"
  "dispose · 1 · 9": "shutdown retains terminal worker results until owned work"
  "dispose · 1 · 10": "settles."
}

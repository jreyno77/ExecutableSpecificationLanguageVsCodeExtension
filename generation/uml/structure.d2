  shape: class
  # expec-uml: 
  "construction(hover)": ""
  # expec-uml: 
  "information(document, position)": ""
  "Promises · information": ""
  "information · 1": "Convert the exact current standard LSP TextDocument and"
  "information · 1 · 2": "UTF-16 Position to one SourceHover.hover query using its"
  "information · 1 · 3": "URI/version and a Unicode-scalar offset. Reject negative,"
  "information · 1 · 4": "fractional, out-of-line positions or positions inside a"
  "information · 1 · 5": "surrogate pair with absence; never clamp. Convert the"
  "information · 1 · 6": "reply's referring name range with its exact captured source"
  "information · 1 · 7": "back to a standard LSP Hover range. Render the authored"
  "information · 1 · 8": "signature in an expec fenced code block and its nonempty"
  "information · 1 · 9": "description as literal Markdown text beneath it. Choose a"
  "information · 1 · 10": "fence longer than any run of backticks in the signature,"
  "information · 1 · 11": "escape Markdown and HTML in the description, and never"
  "information · 1 · 12": "enable command links or trusted HTML. Absence stays absence."
  "information · 1 · 13": "The adapter owns coordinates and presentation only; it never"
  "information · 1 · 14": "parses, checks, chooses a declaration, reads files,"
  "information · 1 · 15": "generates or constructs another analysis."
}

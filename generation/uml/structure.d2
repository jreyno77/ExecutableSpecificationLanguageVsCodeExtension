  "construction(references)": ""
  # expec-uml: 
  "references(document, position, includeDeclaration)": ""
  "Promises · references": ""
  "references · 1": "Translate this exact current standard TextDocument and LSP"
  "references · 1 · 2": "UTF-16 position to a Unicode-scalar cursor and call"
  "references · 1 · 3": "SourceReferences.search once with its URI/version and"
  "references · 1 · 4": "unchanged includeDeclaration flag. Invalid negative,"
  "references · 1 · 5": "fractional, out-of-line or surrogate-splitting positions"
  "references · 1 · 6": "return absence without clamping. Absent core results stay"
  "references · 1 · 7": "absent. Require the reply's requesting URI/text to equal"
  "references · 1 · 8": "this document. Validate each actual occurrence's finite"
  "references · 1 · 9": "nonempty scalar range against its supplied captured source"
  "references · 1 · 10": "before converting it to standard Location; do not guess from"
  "references · 1 · 11": "spelling, basename or saved files. Invalid replies return"
  "references · 1 · 12": "absence rather than a partial fabricated success. Preserve"
  "references · 1 · 13": "the core's ordered distinct locations and plain"
  "references · 1 · 14": "coverage/prerequisite lists. This adapter performs only"
  "references · 1 · 15": "protocol/coordinate conversion, never parsing, resolution,"
  "references · 1 · 16": "compilation, acquisition, scanning, saving or generation."
  "references · 1 · 17": "LanguageServerAdapter owns one standard registration and the"
  "references · 1 · 18": "shared analysis lifetime."
}

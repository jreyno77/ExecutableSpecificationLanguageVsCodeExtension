  # expec-uml: 
  "rename(document, position, newName)": ""
  "Promises · rename": ""
  "rename · 1": "Convert the current standard document/position once and"
  "rename · 1 · 2": "forward decoded newName unchanged to core rename. Validate"
  "rename · 1 · 3": "all returned exact source/scalar ranges, nonoverlap,"
  "rename · 1 · 4": "distinct document URIs and nonnegative integer optional"
  "rename · 1 · 5": "versions, and requester URI/text/version equality when"

s_83bf5b4150d52848cec9e9b56cc008e1bff7a886ec339de57718bfe2c22fb6fd: "«component»\nSourceOutlineAdapter" {
  shape: class
  # expec-uml: 
  "construction(outline)": ""
  # expec-uml: 
  "symbols(document)": ""
  "Promises · symbols": ""
  "symbols · 1": "Ask the one supplied DocumentOutline for this exact native"
  "symbols · 1 · 2": "document URI/version. Without a current reply whose captured"
  "symbols · 1 · 3": "URI and text exactly match document.getText(), return an"
  "symbols · 1 · 4": "empty list. Convert the reply's whole and authored-name"
  "symbols · 1 · 5": "scalar offsets to zero-based UTF-16 LSP range and"
  "symbols · 1 · 6": "selectionRange against that same captured text, retaining"
  "symbols · 1 · 7": "decoded names, source order and nested children. Require"
  "symbols · 1 · 8": "finite integer offsets, valid scalar boundaries and"
  "symbols · 1 · 9": "whole-range containment of the nonempty name selection;"
  "symbols · 1 · 10": "reject an invalid reply rather than clamp, widen or guess."
  "symbols · 1 · 11": "Use native DocumentSymbol values only: component maps to"
  "symbols · 1 · 12": "Module, concept to Object, class to Class, interface to"
  "symbols · 1 · 13": "Interface, record-type-declaration to Struct,"
  "symbols · 1 · 14": "alias-type-declaration and opaque-type-declaration to Class,"
  "symbols · 1 · 15": "field to Field, function to Function and capability to"
  "symbols · 1 · 16": "Method. This mapping describes presentation, not a new type"
  "symbols · 1 · 17": "system. Never parse, resolve, compile, read files, generate,"
  "symbols · 1 · 18": "select targets or rebuild the tree in this adapter."
  "symbols · 2": "Native DocumentSymbol names must contain nonwhitespace text."
  "symbols · 2 · 2": "Omit a symbol with an empty or whitespace-only decoded name"
  "symbols · 2 · 3": "and its whole subtree, retaining other valid siblings in"
  "symbols · 2 · 4": "order. Never fabricate a display name or promote its"
  "symbols · 2 · 5": "children beneath a different parent. Core retains the actual"
  "symbols · 2 · 6": "decoded language facts."
}

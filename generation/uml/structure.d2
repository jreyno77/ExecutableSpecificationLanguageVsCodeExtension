s_e864eb12b474327aeaf2574dd4e89fd537e407804353617e0cc93885b5a50943: "«component»\nSourceDefinitionAdapter" {
  shape: class
  # expec-uml: 
  "construction(navigation)": ""
  # expec-uml: 
  "definition(document, position)": ""
  "Promises · definition": ""
  "definition · 1": "Translate a standard LSP UTF-16 position using this exact"
  "definition · 1 · 2": "current TextDocument text into a zero-based Unicode-scalar"
  "definition · 1 · 3": "offset, and ask core SourceNavigation.definition once with"
  "definition · 1 · 4": "its exact URI/version. Reject noninteger, negative or"
  "definition · 1 · 5": "out-of-line positions with absence; do not clamp them or"
  "definition · 1 · 6": "split a surrogate pair into a guessed scalar. Translate the"
  "definition · 1 · 7": "returned authored name range back to standard UTF-16"
  "definition · 1 · 8": "Location using the reply's exact captured target text and"
  "definition · 1 · 9": "URI. Absence stays absence. This adapter owns only"
  "definition · 1 · 10": "coordinate/protocol conversion; it never parses, resolves,"
  "definition · 1 · 11": "compiles, chooses a declaration, reads files, saves or"
  "definition · 1 · 12": "generates. The shared LanguageServerAdapter owns its one"
  "definition · 1 · 13": "registration and current document lifecycle; no second"
  "definition · 1 · 14": "DocumentAnalysis is constructed."
}

  shape: class
  # expec-uml: 
  "construction(core)": ""
  # expec-uml: 
  "documentChanged(document)": ""
  "Promises · documentChanged": ""
  "documentChanged · 1": "For the supplied editor change, capture a new SourceDocument"
  "documentChanged · 1 · 2": "from document.uri.toString() and document.getText() at this"
  "documentChanged · 1 · 3": "call. Pass that snapshot to core.preview once and return"
  "documentChanged · 1 · 4": "core's tabs unchanged. Preserve the full URI for file,"
  "documentChanged · 1 · 5": "untitled and remote documents; do not read files or request"
  "documentChanged · 1 · 6": "a save. Later edits must not change an earlier snapshot."
  # expec-uml: 
  "documentSaved(document)": ""
  "Promises · documentSaved": ""
  "documentSaved · 1": "For the supplied save notification, capture a new"
  "documentSaved · 1 · 2": "SourceDocument from document.uri.toString() and"
  "documentSaved · 1 · 3": "document.getText() at this call. Pass that snapshot to"
  "documentSaved · 1 · 4": "core.sourceSaved once without requesting a preview or"
  "documentSaved · 1 · 5": "another save. Core owns the generation policy."
}

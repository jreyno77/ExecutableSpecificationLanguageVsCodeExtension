  "start()": ""
  "Promises · start": ""
  "start · 1": "Register once the real post-save and open/change/close"
  "start · 1 · 2": "events, Enable Generation on Save"
  "start · 1 · 3": "(expec.enableGenerationOnSave) and Disable Generation on"
  "start · 1 · 4": "Save (expec.disableGenerationOnSave). Capture"
  "start · 1 · 5": "URI/text/version directly from ordinary local .expec save"
  "start · 1 · 6": "events and forward sourceSaved without saving again. Other"
  "start · 1 · 7": "documents only update buffer facts. Commands adapt an"
  "start · 1 · 8": "explicit author choice for the selected manifest; retain its"
  "start · 1 · 9": "boolean in workspace state keyed by exact manifest URI,"
  "start · 1 · 10": "default false. Assemble one core coordinator with this"
  "start · 1 · 11": "native buffer/presentation adapter and supplied worker. No"
  "start · 1 · 12": "native parsing, generation policy or output planning."
  "start · 1 · 13": "Package the owned generation-worker entry with the pinned"
  "start · 1 · 14": "SDK. Supply resource-scoped expec.nodeExecutable (default"
  "start · 1 · 15": "node; explicit path allowed) to the concrete"
  "start · 1 · 16": "NodeGenerationWorker with its packaged entry. Launch without"
  "start · 1 · 17": "a shell, never fork's default Electron executable. Show the"
  "start · 1 · 18": "actual child version or launch error; preview packaging"
  "start · 1 · 19": "alone does not prove full CLI resource closure."
  # expec-uml: 
  "configurationChanged(configuration)": ""
  "Promises · configurationChanged": ""
  "configurationChanged · 1": "Receive the actual active saved ConnectionConfiguration"
  "configurationChanged · 1 · 2": "through the selected sidebar's ConnectionWorkFeedback"
  "configurationChanged · 1 · 3": "observer, or absence on explicit session-only disconnect,"
  "configurationChanged · 1 · 4": "deletion, unavailable selection or transition. Authored"
  "configurationChanged · 1 · 5": "previews and live package analysis independently retain the"
  "configurationChanged · 1 · 6": "raw selected saved configuration; generation is no longer"
  "configurationChanged · 1 · 7": "routed through that preview callback. Withdraw old admission"
  "configurationChanged · 1 · 8": "and clear queued save intents before switching or"
  "configurationChanged · 1 · 9": "suspension, while continuing to record actual terminal"
  "configurationChanged · 1 · 10": "results and partial receipts. Load and retain only the"
  "configurationChanged · 1 · 11": "manifest's prior explicit opt-in, never erase or grant it"
  "configurationChanged · 1 · 12": "because of generic absence, disconnect or reconnection. A"
  "configurationChanged · 1 · 13": "previously disabled manifest stays disabled; restoring an"
  "configurationChanged · 1 · 14": "earlier true opt-in still needs a later genuine source save."
  "configurationChanged · 1 · 15": "Dirty configuration events retain saved text and notify core"
  "configurationChanged · 1 · 16": "of actual buffer changes. Restart may replay active"
  "configurationChanged · 1 · 17": "configuration and current buffer facts, never previous save"
  "configurationChanged · 1 · 18": "intents. Do not edit the language manifest or infer enabled"
  "configurationChanged · 1 · 19": "from writable/connected."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjVlNjVjNDBjLTMxMjYtNDRlNS1iZjFlLWY1MGIwY2M2M2JlNCIsIm93bmVyIjoic180Zjg4ZDRmMzYyZTQzMTMzNjkzNTgzNTJkYzVkY2JhZTRjOGZhMmRiOGNhN2E2Y2RkZWExYjA3MGE5ZGUyZjA5IiwibmFtZSI6ImJ1ZmZlcnMiLCJwYXJhbWV0ZXJzIjpbXX0
  "buffers()": ""
  "Promises · buffers": ""
  "buffers · 1": "Snapshot every current workspace.textDocuments ordinary file"
  "buffers · 1 · 2": "buffer, including hidden target buffers of other languages,"
  "buffers · 1 · 3": "using its actual uri/version/getText/isDirty. Closed buffers"
  "buffers · 1 · 4": "are absent. Keep native document object/lifetime checks"
  "buffers · 1 · 5": "around delayed callbacks; never provide a cached empty or"
  "buffers · 1 · 6": "clean set. Core decides which roots/inputs these facts"
  "buffers · 1 · 7": "protect."
  # expec-uml: 
  "present(state)": ""
  "Promises · present": ""
  "present · 1": "Show core's current generation status and actual explanation"
  "present · 1 · 2": "in one owned native status-bar item and its .expec"
  "present · 1 · 3": "Generation output channel. Keep this distinct from the"
  "present · 1 · 4": "connection directory status. Do not reinterpret permission,"
  "present · 1 · 5": "hide a partial-write warning or show a superseded success as"
  "present · 1 · 6": "current."
  # expec-uml: 
  "record(configurationFile, result)": ""
  "Promises · record": ""
  "record · 1": "Append the actual observed child runtime version and"
  "record · 1 · 2": "unchanged CLI JSON or launch/transport/cleanup failure to"
  "record · 1 · 3": "the owned output channel with its selected manifest context,"
  "record · 1 · 4": "including superseded or cancelled runs and partial effects."
  "record · 1 · 5": "An exit code or dispatched notification alone is not proof"
  "record · 1 · 6": "of saved output."
  # expec-uml: 
  "shutdown(completion)": ""
  "Promises · shutdown": ""
  "shutdown · 1": "Invalidate save/configuration callbacks and remove owned"
  "shutdown · 1 · 2": "events/commands, then dispose core and request worker"
  "shutdown · 1 · 3": "shutdown. Keep terminal effect recording and its output"
  "shutdown · 1 · 4": "channel alive until worker completion; then dispose"
  "shutdown · 1 · 5": "remaining status/output resources, attempt all cleanup and"
  "shutdown · 1 · 6": "notify this completion with any actual causes. Repeated"
  "shutdown · 1 · 7": "callers join the same shutdown. The native entry wraps this"
  "shutdown · 1 · 8": "callback in its one awaited Promise, preserving cleanup"
  "shutdown · 1 · 9": "failures."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6IjgzMTcyNThjLTY2MWMtNGRhNy1hZTkwLWNmMjQzY2YzMDYzZCIsIm93bmVyIjoic180Zjg4ZDRmMzYyZTQzMTMzNjkzNTgzNTJkYzVkY2JhZTRjOGZhMmRiOGNhN2E2Y2RkZWExYjA3MGE5ZGUyZjA5IiwibmFtZSI6ImRpc3Bvc2UiLCJwYXJhbWV0ZXJzIjpbXX0
  "dispose()": ""
  "Promises · dispose": ""
  "dispose · 1": "Initiate this same shutdown once, retaining asynchronous"
  "dispose · 1 · 2": "failure evidence. The entry point explicitly awaits shutdown"
  "dispose · 1 · 3": "completion; this native Disposable method alone is not proof"
  "dispose · 1 · 4": "of process termination. Never roll back user edits."

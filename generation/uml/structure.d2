s_3ca299356d77cf5fcb4b370654e20488ba4e2c2312b9c80a8e94c176ac05f44c: "«component»\nOutputTabs" {
  shape: class
  # expec-uml: 
  "construction(hostElementId)": ""
  # expec-uml: 
  "present(tabs)": ""
  "Promises · present": ""
  "present · 1": "Present exactly the supplied output IDs/labels/order,"
  "present · 1 · 2": "statuses, explanations and ordered document paths. Replace"
  "present · 1 · 3": "the previous presentation. Preserve selected output ID and"
  "present · 1 · 4": "document path while retained. Otherwise choose the first"
  "present · 1 · 5": "output, and prefer its first supplied SVG document, then its"
  "present · 1 · 6": "first Markdown document named Home.md, then its first"
  "present · 1 · 7": "document. The Home.md filename is the final slash-separated"
  "present · 1 · 8": "path segment; ties retain supplied order. Show pending,"
  "present · 1 · 9": "blocked or refused explanations without old documents; ready"
  "present · 1 · 10": "with no documents visibly says No authored documents."
  "present · 2": "Render text/markdown as a readable document with headings,"
  "present · 2 · 2": "lists, GFM tables and fenced code. Hide HTML comments,"
  "present · 2 · 3": "including expec-section, expec-fragment and expec-end"
  "present · 2 · 4": "ownership markers. Convert only exact generated empty"
  "present · 2 · 5": "anchors with an expec- prefix and lowercase hexadecimal"
  "present · 2 · 6": "suffix into inert DOM targets; ignore all other authored"
  "present · 2 · 7": "HTML and attributes. Code-fenced HTML remains visible code."
  "present · 2 · 8": "Never execute authored HTML or load Markdown images; show"
  "present · 2 · 9": "their alt text instead."
  "present · 3": "Markdown links resolve relative to the selected document"
  "present · 3 · 2": "among supplied Markdown paths within the same output."
  "present · 3 · 3": "Following an available link selects that actual document"
  "present · 3 · 4": "path and scrolls its decoded fragment target into view; a"
  "present · 3 · 5": "fragment-only link stays in the current document. Never"
  "present · 3 · 6": "fetch a missing page or use filesystem or VS Code APIs."
  "present · 3 · 7": "External, absolute, command, javascript, file and"
  "present · 3 · 8": "unavailable-page links remain readable and inactive with the"
  "present · 3 · 9": "explanation Link unavailable in supplied previews. A missing"
  "present · 3 · 10": "fragment visibly reports Anchor unavailable in supplied"
  "present · 3 · 11": "preview."
  "present · 4": "Display TypeScript, JSON and other supported text literally."
  "present · 4 · 2": "A D2 document initially shows Diagram preview unavailable."
  "present · 4 · 3": "Select an SVG document or show source. Its explicit Show"
  "present · 4 · 4": "source control reveals the supplied D2 literally. Do not"
  "present · 4 · 5": "render Markdown, SVG or D2 source as the default document"
  "present · 4 · 6": "preview."
  "present · 5": "When an SVG supplies diagram annotations, show a compact"
  "present · 5 · 2": "promise count button beside each annotated capability row;"
  "present · 5 · 3": "hide full promise text by default. Use renderer coordinates"
  "present · 5 · 4": "for the row highlight and button at every zoom level and"
  "present · 5 · 5": "while scrolling. Hover or keyboard focus shows the exact"
  "present · 5 · 6": "promises as readable plain text in an anchored thought"
  "present · 5 · 7": "bubble. Click or Enter pins it; clicking another indicator"
  "present · 5 · 8": "replaces the pinned bubble. Escape, an outside click or"
  "present · 5 · 9": "clicking the pinned indicator closes it. Only one bubble is"
  "present · 5 · 10": "visible; pointer leave or focus leave closes an unpinned"
  "present · 5 · 11": "bubble. The bubble stays open when its content is hovered."
  "present · 5 · 12": "Keep long text wrapped and independently scrollable. Never"
  "present · 5 · 13": "interpret promise text as HTML or Markdown."
  "present · 6": "The promise state belongs only to the current image and"
  "present · 6 · 2": "annotations. Switching documents/outputs, replacing content"
  "present · 6 · 3": "or annotations, withdrawing a ready preview and disposal"
  "present · 6 · 4": "clear it. Show no controls for unannotated SVGs or"
  "present · 6 · 5": "operations without promises. Keep indicators keyboard"
  "present · 6 · 6": "accessible with the capability label and promise count,"
  "present · 6 · 7": "aria-expanded state and an accessible popup label. Escape"
  "present · 6 · 8": "returns to the closed state without reopening just because"
  "present · 6 · 9": "focus remains on the indicator."
  "present · 7": "Display image/svg+xml as an inert image from its supplied"
  "present · 7 · 2": "UTF-8 content, never injected markup or a target-file path."
  "present · 7 · 3": "Use a scroll viewport with default 100 percent scale,"
  "present · 7 · 4": "author-controlled zoom and reset to 100 percent; do not"
  "present · 7 · 5": "shrink wide images to fit. Dispose replaced image resources"
  "present · 7 · 6": "and bind image events to the actual content's current node."
  "present · 7 · 7": "Unsupported presentation media shows a clear explanation and"
  "present · 7 · 8": "retains its path/type. Selection, source viewing and"
  "present · 7 · 9": "document navigation never compile, generate, write, fetch"
  "present · 7 · 10": "external resources or implement report freshness."
  # expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsIm1lbWJlciI6ImUzZThkYzBmLTJjYjQtNDU1Zi05MTA0LTAyZTk5MzY5YmFiNiIsIm93bmVyIjoic18zY2EyOTkzNTZkNzdjZjVmY2I0YjM3MDY1NGUyMDQ4OGJhNGUyYzIzMTJiOWM4MGE4ZTk0YzE3NmFjMDVmNDRjIiwibmFtZSI6ImRpc3Bvc2UiLCJwYXJhbWV0ZXJzIjpbXX0
  "dispose()": ""
  "Promises · dispose": ""
  "dispose · 1": "Unmount this view and release its handlers and owned image"
  "dispose · 1 · 2": "resources. Keep the supplied host element in the page."
  "dispose · 1 · 3": "Repeated disposal is harmless; present after disposal"
  "dispose · 1 · 4": "reports a clear error."
}

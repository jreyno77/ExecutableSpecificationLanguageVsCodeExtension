  # expec-uml: 
  "construction(outputs, generateOnSave)": ""
  # expec-uml: 
  "preview(source)": ""
  "Promises · preview": ""
  "preview · 1": "Ask the connected outputs to preview this exact document and"
  "preview · 1 · 2": "return their tabs unchanged. Do not request generation."
  # expec-uml: 
  "sourceSaved(source)": ""
  "Promises · sourceSaved": ""
  "sourceSaved · 1": "If generateOnSave is enabled, request generation of this"
  "sourceSaved · 1 · 2": "exact document once. Otherwise request nothing. This"
  "sourceSaved · 1 · 3": "observes an editor save; it does not save the source file."
}

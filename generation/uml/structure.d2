s_e0da6d9b0a1fdec6ca7ab1f9eb3548f0dc5b26a4f5c7508bb73ccd5fc10874bf: "«interface»\nProjectOutputs" {
  shape: class
  # expec-uml: 
  "preview(source)": ""
  "Promises · preview": ""
  "preview · 1": "Use the supplied document text, including unsaved edits,"
  "preview · 1 · 2": "without writing project files. Return one tab per configured"
  "preview · 1 · 3": "output in configuration order, retaining its registration ID"
  "preview · 1 · 4": "and label. This established synchronous seam forwards"
  "preview · 1 · 5": "supplied tabs; EXT-05's native live previews instead receive"
  "preview · 1 · 6": "current DocumentReport publications through OutputPreviews,"
  "preview · 1 · 7": "without another parser or a duplicate live pipeline."
  # expec-uml: 
  "generate(source)": ""
  "Promises · generate": ""
  "generate · 1": "Generate from the supplied document through this"
  "generate · 1 · 2": "connection's configured outputs and existing ownership and"
  "generate · 1 · 3": "preservation rules. Never overwrite handwritten work."
}

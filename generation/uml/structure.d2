  "openDocuments · 1 · 6": "editor selection."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiJhNTY2ODkyYS04YzJiLTQ1ZGMtYjhhMC1kNDNlNmY2MDY3NzQiLCJraW5kIjoiaW50ZXJmYWNlIiwibmFtZSI6IlNvdXJjZUlkZW50aXRpZXMifQ
s_0fbf70fa75b7a12f4f0849a610e9318a91a607d832723a14a876c058387c971d: "«interface»\nSourceIdentities" {
  shape: class
  # expec-uml: 
  "keyOf(uri, manifestFile)": ""
  "Promises · keyOf": ""
  "keyOf · 1": "Return the current opaque physical source identity within"
  "keyOf · 1 · 2": "this selected manifest, or absence when native facts cannot"
  "keyOf · 1 · 3": "establish it. Equal known keys establish the same actual"
  "keyOf · 1 · 4": "file; different known keys establish different actual files"
  "keyOf · 1 · 5": "in this capture. The provider owns filesystem observation"
  "keyOf · 1 · 6": "and ancestry checks; core receives no native handles or"
  "keyOf · 1 · 7": "filesystem APIs. Never derive a key from URI spelling,"
  "keyOf · 1 · 8": "decoded or case-folded strings, localPath, source text or"
  "keyOf · 1 · 9": "declaration names. Keys are only equality facts for the"
  "keyOf · 1 · 10": "current capture, never persistent or cross-project"
  "keyOf · 1 · 11": "identifiers. A native file that has never been saved may"
  "keyOf · 1 · 12": "have no identity: preserve absence so rename can explain its"
  "keyOf · 1 · 13": "actual URI and ask the author to save first. No project"
  "keyOf · 1 · 14": "scan, package capture, parsing, generation or writes."
  "keyOf · 1 · 15": "Unexpected provider errors surface. Return current facts on"
  "keyOf · 1 · 16": "every query so the caller can recheck all acquired and"
  "keyOf · 1 · 17": "routed source identities before returning a plan."
}
# expec-uml: eyJmb3JtYXQiOjEsIm91dHB1dElkIjoidW1sIiwidmlldyI6InN0cnVjdHVyZSIsImRlZmluaXRpb24iOiI3ZmNmOTBkMy03ZWUzLTQ1ZTItYjc4My1mYjJmYzkxNjdkYjkiLCJraW5kIjoiY29tcG9uZW50IiwibmFtZSI6IlNvdXJjZVJlbmFtZSJ9
s_59d1da264bc927fb207545f213f1a60893f31f29c07b62a8798bb4632ec977a2: "«component»\nSourceRename" {
  shape: class
  # expec-uml: 
  "construction(workspace, sources, identities)": ""
  # expec-uml: 
  "prepare(uri, version, offset)": ""
  "Promises · prepare": ""
  "prepare · 1": "Check one explicit rename request against the selected"
  "prepare · 1 · 2": "manifest's actual build.entries and every transitive"
  "prepare · 1 · 3": "use/include/examples attachment reached from those entries,"
  "prepare · 1 · 4": "including reverse users reached from another entry. This is"
  "prepare · 1 · 5": "configured-build scope, not arbitrary workspace files or"
  "prepare · 1 · 6": "other projects. Read validated configuration through the"
  "prepare · 1 · 7": "public ConfigurationReader; a generated-output connection is"
  "prepare · 1 · 8": "not required. Use current open text before saved"
  "prepare · 1 · 9": "DocumentSources text, including new unsaved import locators."
  "prepare · 1 · 10": "Capture each exact URI/text once per analysis and terminate"
  "prepare · 1 · 11": "cycles; never reuse an accepted model after rejected text."
  "prepare · 1 · 12": "Ask SourceIdentities.keyOf for actual physical equality"
  "prepare · 1 · 13": "independently of DocumentSources.localPath, which remains"
  "prepare · 1 · 14": "literal requirement-scope metadata. A resolved route may use"
  "prepare · 1 · 15": "one current open buffer only when both its verified primary"
  "prepare · 1 · 16": "manifest-relative path and its known physical key agree with"
  "prepare · 1 · 17": "that buffer. Preserve the exact open URI/text/version in"
  "prepare · 1 · 18": "captured sources, models and returned edits. Refuse multiple"
  "prepare · 1 · 19": "open identities for one physical file, an equal path with"
  "prepare · 1 · 20": "different or unknown physical keys, or distinct effective"
  "prepare · 1 · 21": "acquired URIs sharing one physical key. Different paths with"
  "prepare · 1 · 22": "the same key, including native case aliases and hardlinks,"
  "prepare · 1 · 23": "refuse rather than merge requirement scopes. Unknown"
  "prepare · 1 · 24": "identities of unrelated uncaptured foreign open buffers do"
  "prepare · 1 · 25": "not match and do not block an otherwise complete rename."
  "prepare · 1 · 26": "Never infer physical equality from URI or path spelling,"
  "prepare · 1 · 27": "case-folding, percent decoding or equal text. Use public"
  "prepare · 1 · 28": "LangiumReader, LangiumModel, SourceComposer and Compiler for"
  "prepare · 1 · 29": "one shared batch of all configured entries, with the same"
  "prepare · 1 · 30": "captured module objects and supplied package aliases/phases."
  "prepare · 1 · 31": "Resolve configured entry paths relative to the selected"
  "prepare · 1 · 32": "manifest URI or absolute native filename, never the"
  "prepare · 1 · 33": "generated project.root. Do not create another parser or"
  "prepare · 1 · 34": "resolver. Ordinary live diagnostics and bounded references"
  "prepare · 1 · 35": "remain unchanged; only explicit prepare/rename can acquire"
  "prepare · 1 · 36": "this configured source set. Never use native project"
  "prepare · 1 · 37": "capture, SourceLoader's saved-only snapshots, package"
  "prepare · 1 · 38": "installation, JVMs, output generation or writes."
  "prepare · 2": "Require the requesting exact URI/version to be open in this"
  "prepare · 2 · 2": "captured configured scope. Require finite nonnegative"
  "prepare · 2 · 3": "integer version/offset, otherwise throw RangeError. Select"
  "prepare · 2 · 4": "the actual named source declaration or checked source-name"
  "prepare · 2 · 5": "use (including a record field label or bound final reference"
  "prepare · 2 · 6": "segment) containing the zero-based Unicode-scalar cursor;"
  "prepare · 2 · 7": "return its whole authored token range in the requesting"
  "prepare · 2 · 8": "source and decoded target name. Comments, punctuation,"
  "prepare · 2 · 9": "qualified-reference prefix segments,"
  "prepare · 2 · 10": "builtin/external/unnamed targets, unresolved/ambiguous"
  "prepare · 2 · 11": "targets and foreign source ownership refuse with an"
  "prepare · 2 · 12": "explained Error. Every acquired configured source must have"
  "prepare · 2 · 13": "a verified primary manifest-relative path from"
  "prepare · 2 · 14": "DocumentSources.localPath and a known physical key from"
  "prepare · 2 · 15": "SourceIdentities.keyOf. An unknown acquired identity refuses"
  "prepare · 2 · 16": "with the actual URI; explain save first when a new native"
  "prepare · 2 · 17": "file has no identity. A selected alias-use cursor or a"
  "prepare · 2 · 18": "same-spelled explicit alias to this target refuses rather"
  "prepare · 2 · 19": "than guessing which introduction supplied that spelling. A"
  "prepare · 2 · 20": "direct declaration or import source-name remains eligible"
  "prepare · 2 · 21": "beside a distinct explicit alias."
  "prepare · 3": "Refuse incomplete or invalid checked analysis: missing"
  "prepare · 3 · 2": "required source, rejected syntax, actual compiler problems,"
  "prepare · 3 · 3": "deferred compilation prerequisites or invalid"
  "prepare · 3 · 4": "requirementsFor findings remain explained, never repaired by"
  "prepare · 3 · 5": "scanning. Use Specification.names.at, inSource and"
  "prepare · 3 · 6": "occurrencesOf for the actual checked spelling owner, not raw"
  "prepare · 3 · 7": "contextual Inspection.resolution. Require complete"
  "prepare · 3 · 8": "finding-free source-name queries even after compilation"
  "prepare · 3 · 9": "succeeds; ambiguous-source-name and source-name-selection"
  "prepare · 3 · 10": "findings refuse. Structurally empty-name captured input"
  "prepare · 3 · 11": "models need no invented query source identity. Contextual"
  "prepare · 3 · 12": "resolver deferrals already discharged by Compiler are not"
  "prepare · 3 · 13": "independent failures. Before returning, require the selected"
  "prepare · 3 · 14": "configuration and all captured open URI/text/version facts"
  "prepare · 3 · 15": "to remain equal and freshly re-read saved-only captures to"
  "prepare · 3 · 16": "match exactly. After the final saved-only rereads, requery"
  "prepare · 3 · 17": "every acquired URI and every resolved alias route that was"
  "prepare · 3 · 18": "mapped to an open buffer through SourceIdentities.keyOf"
  "prepare · 3 · 19": "using the same captured manifest; each known physical key"
  "prepare · 3 · 20": "must still agree with its captured key. Recheck current"
  "prepare · 3 · 21": "configuration and open facts after identity-provider"
  "prepare · 3 · 22": "callbacks. A changed, missing or contradictory identity"
  "prepare · 3 · 23": "refuses instead of returning an older routing plan. Explain"
  "prepare · 3 · 24": "changed input instead of returning older facts. There is no"
  "prepare · 3 · 25": "cross-call target handle: rename performs fresh capture and"
  "prepare · 3 · 26": "selection. Expected refusals use ordinary Error messages"
  "prepare · 3 · 27": "naming the actual unavailable URI, declined alias/name or"
  "prepare · 3 · 28": "changed/conflicting input; do not fabricate an empty"
  "prepare · 3 · 29": "successful edit. Unexpected provider/SDK errors surface."
  # expec-uml: 
  "rename(uri, version, offset, newName)": ""
  "Promises · rename": ""
  "rename · 1": "Apply prepare's same source-scope, selection, validity and"
  "rename · 1 · 2": "final-currentness rules to fresh inputs. newName is the"
  "rename · 1 · 3": "decoded name, not source syntax. Reject empty names, control"
  "rename · 1 · 4": "characters and unpaired surrogates with an explained Error;"
  "rename · 1 · 5": "do not trim or normalize Unicode or whitespace. Use the real"
  "rename · 1 · 6": "reader to admit an ordinary single-name spelling consuming"
  "rename · 1 · 7": "the entire candidate token; otherwise render a backtick name"
  "rename · 1 · 8": "escaping backticks/backslashes and validate that complete"
  "rename · 1 · 9": "token with the reader. A temporary inert synthetic source"
  "rename · 1 · 10": "may validate spelling only: require exactly one declaration,"
  "rename · 1 · 11": "its whole nameOrigin consuming the candidate token and its"
  "rename · 1 · 12": "decoded name equal to newName. Reject injected trailing"
  "rename · 1 · 13": "declarations/tokens. Never accept unchecked interpolation or"
  "rename · 1 · 14": "use a second keyword/identifier grammar. An unchanged"
  "rename · 1 · 15": "decoded name returns an empty edit list after validation."
  "rename · 2": "Plan the declaration name and all safely identified bound"
  "rename · 2 · 2": "occurrences of that same declaration across the captured"
  "rename · 2 · 3": "configured entries. Edit import source-name tokens, keeping"
  "rename · 2 · 4": "distinct explicit aliases and their uses unchanged. Do not"
  "rename · 2 · 5": "replace every location from bounded reference search, edit"
  "rename · 2 · 6": "strings/comments, rename an unrelated same-named"
  "rename · 2 · 7": "declaration, alter manifest metadata, generate files or"
  "rename · 2 · 8": "execute a save. Same-spelled explicit alias routing refuses;"
  "rename · 2 · 9": "selected qualifier renames and any other unproven routing"
  "rename · 2 · 10": "refuse rather than dropping affected occurrences. Return"
  "rename · 2 · 11": "only affected documents in URI code-unit order, each with"
  "rename · 2 · 12": "exact captured source, its actual open version or absence"
  "rename · 2 · 13": "for saved-only text, and distinct nonoverlapping scalar"
  "rename · 2 · 14": "edits in descending start order. Return caller-isolated"
  "rename · 2 · 15": "facts."
  "rename · 3": "Check the hypothetical edited source snapshots through the"
  "rename · 3 · 2": "same real language pipeline before returning. Clean"
  "rename · 3 · 3": "compilation alone is insufficient: match source declarations"
  "rename · 3 · 4": "by their mapped authored provenance/kind and every actual"
  "rename · 3 · 5": "checked source-name token's spelling-owner declaration by"
  "rename · 3 · 6": "mapped source/name ranges, including unchanged references"
  "rename · 3 · 7": "that a new name could capture. Require a full two-way"
  "rename · 3 · 8": "correspondence of complete before/after name sets: compare"
  "rename · 3 · 9": "actual source owner kind and mapped nameOrigin (actual Name"
  "rename · 3 · 10": "origin for aliases/captures), and stable builtin/external"
  "rename · 3 · 11": "provenance where applicable. Unchanged tokens retain"
  "rename · 3 · 12": "spelling/owner, while edited target-owned tokens have the"
  "rename · 3 · 13": "decoded newName and mapped owner. Opaque NodeIds are valid"
  "rename · 3 · 14": "only inside their own analysis and must not be compared"
  "rename · 3 · 15": "across reparses. Refuse duplicate declarations, changed"
  "rename · 3 · 16": "binding, lost qualified uses, new ambiguity or any"
  "rename · 3 · 17": "new/retained prerequisite; expose the conflicting newName or"
  "rename · 3 · 18": "actual finding. No partial plan escapes a refusal. This"
  "rename · 3 · 19": "promises a complete intended edit against captured sources"
  "rename · 3 · 20": "and detects supersession while computing; the ordinary"
  "rename · 3 · 21": "editor owns later preview/apply, optional edit selection and"
  "rename · 3 · 22": "undo. It does not promise filesystem/editor atomicity after"
  "rename · 3 · 23": "the response."
}

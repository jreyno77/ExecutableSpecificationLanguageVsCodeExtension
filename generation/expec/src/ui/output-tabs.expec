use OutputTab from "../core/workspace.expec"

component OutputTabs {
  requires package "react" for runtime
  requires package "react-dom" for runtime
  requires package "react-markdown" for runtime
  requires package "remark-gfm" for runtime

  // The UI host supplies the ID of an existing empty DOM element.
  // Missing or occupied hosts are rejected; this view owns only its rendered children.
  construction(hostElementId: Text)
  public present, dispose

  capability present(tabs: List<OutputTab>) returns Nothing {
    promises "Present exactly the supplied output IDs/labels/order, statuses, explanations and ordered document paths. Replace the previous presentation. Preserve selected output ID and document path while retained. Otherwise choose the first output, and prefer its first supplied SVG document, then its first Markdown document named Home.md, then its first document. The Home.md filename is the final slash-separated path segment; ties retain supplied order. Show pending, blocked or refused explanations without old documents; ready with no documents visibly says No authored documents."
    promises "Render text/markdown as a readable document with headings, lists, GFM tables and fenced code. Hide HTML comments, including expec-section, expec-fragment and expec-end ownership markers. Convert only exact generated empty anchors with an expec- prefix and lowercase hexadecimal suffix into inert DOM targets; ignore all other authored HTML and attributes. Code-fenced HTML remains visible code. Never execute authored HTML or load Markdown images; show their alt text instead."
    promises "Markdown links resolve relative to the selected document among supplied Markdown paths within the same output. Following an available link selects that actual document path and scrolls its decoded fragment target into view; a fragment-only link stays in the current document. Never fetch a missing page or use filesystem or VS Code APIs. External, absolute, command, javascript, file and unavailable-page links remain readable and inactive with the explanation Link unavailable in supplied previews. A missing fragment visibly reports Anchor unavailable in supplied preview."
    promises "Display TypeScript, JSON and other supported text literally. A D2 document initially shows Diagram preview unavailable. Select an SVG document or show source. Its explicit Show source control reveals the supplied D2 literally. Do not render Markdown, SVG or D2 source as the default document preview."
    promises "When an SVG supplies diagram annotations, show a compact promise count button beside each annotated capability row; hide full promise text by default. Use renderer coordinates for the row highlight and button at every zoom level and while scrolling. Hover or keyboard focus shows the exact promises as readable plain text in an anchored thought bubble. Click or Enter pins it; clicking another indicator replaces the pinned bubble. Escape, an outside click or clicking the pinned indicator closes it. Only one bubble is visible; pointer leave or focus leave closes an unpinned bubble. The bubble stays open when its content is hovered. Keep long text wrapped and independently scrollable. Never interpret promise text as HTML or Markdown."
    promises "The promise state belongs only to the current image and annotations. Switching documents/outputs, replacing content or annotations, withdrawing a ready preview and disposal clear it. Show no controls for unannotated SVGs or operations without promises. Keep indicators keyboard accessible with the capability label and promise count, aria-expanded state and an accessible popup label. Escape returns to the closed state without reopening just because focus remains on the indicator."
    promises "Display image/svg+xml as an inert image from its supplied UTF-8 content, never injected markup or a target-file path. Use a scroll viewport with default 100 percent scale, author-controlled zoom and reset to 100 percent; do not shrink wide images to fit. Dispose replaced image resources and bind image events to the actual content's current node. Unsupported presentation media shows a clear explanation and retains its path/type. Selection, source viewing and document navigation never compile, generate, write, fetch external resources or implement report freshness."
  }

  // Diagram interactions are presentation state; no language resolution or generation occurs.
  capability dispose() returns Nothing {
    promises "Unmount this view and release its handlers and owned image resources. Keep the supplied host element in the page. Repeated disposal is harmless; present after disposal reports a clear error."
  }
}

// The driver presents through OutputTabs and observes rendered DOM/image geometry,
// never its own input copy. The owned browser viewport is 640 by 480 pixels.
// Supplied presentation fixtures prove UI behavior, not real language rendering.
// Core examples use actual registered renderers. SVG image load/natural/displayed
// dimensions prove browser rendering here; zoom/scroll observations read actual UI.
examples for OutputTabs {
  fixture emptyDocumentPaths: List<Text> = []
  fixture emptyPreviewRequests: List<Text> = []
  fixture previews: List<OutputTab> = [
    { id: "uml", label: "UML", status: "ready", documents: [
      { path: "structure.d2", mediaType: "text/vnd.d2", content: "Book: { title: Text }" }
    ] },
    { id: "typescript", label: "TypeScript", status: "ready", documents: [
      { path: "Book.ts", mediaType: "text/typescript", content: "export interface Book { title: string }" }
    ] },
    { id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "Book.md", mediaType: "text/markdown", content: "# Book" }
    ] }
  ]
  fixture diagrams: List<OutputTab> = [
    { id: "uml", label: "UML", status: "ready", documents: [
      { path: "structure.d2", mediaType: "text/vnd.d2", content: "Book: { title: Text }" },
      { path: "structure.svg", mediaType: "image/svg+xml", content: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1800\" height=\"1200\" viewBox=\"0 0 1800 1200\"><rect width=\"1800\" height=\"1200\" fill=\"white\"/><text x=\"40\" y=\"60\" font-size=\"20\">Book</text></svg>" }
    ] }
  ]

  fixture revisedDiagrams: List<OutputTab> = [
    { id: "uml", label: "UML", status: "ready", documents: [
      { path: "notes.d2", mediaType: "text/vnd.d2", content: "Novel: { title: Number }" },
      { path: "structure.svg", mediaType: "image/svg+xml", content: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1800\" height=\"1200\" viewBox=\"0 0 1800 1200\"><rect width=\"1800\" height=\"1200\" fill=\"white\"/><text x=\"40\" y=\"60\" font-size=\"20\">Novel</text></svg>" }
    ] }
  ]

  fixture readableMarkdown: List<OutputTab> = [
    { id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "Books.md", mediaType: "text/markdown", content: "# Books\n\n- Dune\n- Emma\n\n| Book | Copies |\n| --- | --- |\n| Dune | 2 |\n\n```expec\ntype Book { title: Text }\n```\n" }
    ] }
  ]
  fixture wikiPages: List<OutputTab> = [
    { id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "docs/reference/Book.md", mediaType: "text/markdown", content: "# Book\n\n[Home](../Home.md#expec-686f6d65)\n\n[Book details](#expec-626f6f6b)\n\n- Arrival\n- Discovery\n- Departure\n- Journey\n- Storm\n- Shelter\n- Message\n- Search\n- Meeting\n- Promise\n- Return\n- Reunion\n- Celebration\n- Tomorrow\n- Afterword\n- Credits\n\n<a id=\"expec-626f6f6b\"></a>\n\n## Book details\n\nTitle and available copies.\n" },
      { path: "docs/Home.md", mediaType: "text/markdown", content: "<!-- expec-section:7b226f75747075744964223a226d61726b646f776e222c22737065634964223a22686f6d65227d -->\n\n# Library\n\n<a id=\"expec-686f6d65\"></a>\n\n[Read Book](reference/Book.md#expec-626f6f6b)\n\n[Missing section](#expec-6d697373696e67)\n\n<!-- expec-end:686f6d65 -->\n" }
    ] }
  ]

  setup openOutputTabs() returns Nothing
  action presentOutputs(tabs: List<OutputTab>) returns Nothing
  action selectOutput(id: Text) returns Nothing
  action selectOutputDocument(path: Text) returns Nothing
  action showOutputSource() returns Nothing
  action followDocumentLink(label: Text) returns Nothing
  action setDiagramZoom(percent: Number) returns Nothing
  action resetDiagramZoom() returns Nothing
  action scrollDiagram(horizontal: Number, vertical: Number) returns Nothing
  action disposeOutputTabs() returns Nothing
  observation outputLabels() returns List<Text>
  observation selectedOutputContent() returns Text
  observation outputHostExists() returns Boolean
  observation selectedOutputId() returns Text
  observation selectedOutputStatus() returns Text
  observation selectedOutputExplanation() returns Text
  observation selectedDocumentPaths() returns List<Text>
  observation selectedDocumentPath() returns Text
  observation diagramImageLoaded() returns Boolean
  observation diagramZoomPercent() returns Number
  observation diagramDisplayedWidth() returns Number
  observation diagramScrollLeft() returns Number
  observation diagramScrollTop() returns Number
  observation markdownHeadings() returns List<Text>
  observation markdownListItems() returns List<Text>
  observation markdownTableRows() returns List<List<Text>>
  observation markdownCodeBlocks() returns List<Text>
  observation markdownAnchorInView(anchor: Text) returns Boolean
  observation documentContainsText(text: Text) returns Boolean
  observation inactiveDocumentLinks() returns List<Text>
  observation previewHasUnsafeContent() returns Boolean
  observation previewResourceRequests() returns List<Text>

  // Markdown observations inspect actual rendered heading/list/table/code elements.
  // Anchor visibility reads the actual target geometry after following the link.
  // Safety observes the preview DOM, attempted resource requests and an authored
  // window.expecPreviewUnsafe execution probe; it never reports the supplied input.
  check expectMarkdownHeadings(expected: List<Text>) {
    let actual = markdownHeadings()
    assert actual == expected
  }
  check expectMarkdownCodeBlocks(expected: List<Text>) {
    let actual = markdownCodeBlocks()
    assert actual == expected
  }
  check expectReadableMarkdown() {
    let headings = markdownHeadings()
    let items = markdownListItems()
    let rows = markdownTableRows()
    let code = markdownCodeBlocks()
    assert headings == ["Books"]
    assert items == ["Dune", "Emma"]
    assert rows == [["Book", "Copies"], ["Dune", "2"]]
    assert code == ["type Book { title: Text }\n"]
  }
  check expectDocumentAnchor(anchor: Text) {
    let visible = markdownAnchorInView(anchor)
    assert visible == true
  }
  check expectDocumentTextAbsent(text: Text) {
    let present = documentContainsText(text)
    assert present == false
  }
  check expectInactiveDocumentLinks(expected: List<Text>) {
    let actual = inactiveDocumentLinks()
    assert actual == expected
  }
  check expectSafePreview() {
    let unsafe = previewHasUnsafeContent()
    let requests = previewResourceRequests()
    assert unsafe == false
    assert requests == emptyPreviewRequests
  }
  check expectDocumentExplanation(expected: Text) {
    let actual = selectedOutputExplanation()
    assert actual == expected
  }

  check expectOutputLabels(expected: List<Text>) {
    let actual = outputLabels()
    assert actual == expected
  }
  check expectOutputContent(expected: Text) {
    let actual = selectedOutputContent()
    assert actual == expected
  }
  check expectOutputHostRetained() {
    let actual = outputHostExists()
    assert actual == true
  }
  check expectSelectedOutput(id: Text) {
    let actual = selectedOutputId()
    assert actual == id
  }
  check expectOutputStatus(status: Text, explanation: Text) {
    let actualStatus = selectedOutputStatus()
    let actualExplanation = selectedOutputExplanation()
    let documents = selectedDocumentPaths()
    assert actualStatus == status
    assert actualExplanation == explanation
    assert documents == emptyDocumentPaths
  }
  check expectSelectedDocument(path: Text, paths: List<Text>) {
    let actual = selectedDocumentPath()
    let actualPaths = selectedDocumentPaths()
    assert actual == path
    assert actualPaths == paths
  }
  check expectLoadedDiagram(percent: Number, width: Number) {
    let loaded = diagramImageLoaded()
    let actualPercent = diagramZoomPercent()
    let actualWidth = diagramDisplayedWidth()
    assert loaded == true
    assert actualPercent == percent
    assert actualWidth == width
  }
  check expectDiagramScroll(horizontal: Number, vertical: Number) {
    let actualHorizontal = diagramScrollLeft()
    let actualVertical = diagramScrollTop()
    assert actualHorizontal == horizontal
    assert actualVertical == vertical
  }

  scenario "see a tab for each supplied output" {
    given openOutputTabs()
    when presentOutputs(previews)
    then expectOutputLabels(["UML", "TypeScript", "Markdown"])
  }

  scenario "read the selected output" {
    given openOutputTabs()
    when presentOutputs(previews)
    when selectOutput("typescript")
    then expectOutputContent("export interface Book { title: string }")
  }

  scenario "replace the previous tabs when the available outputs change" {
    given openOutputTabs()
    when presentOutputs(previews)
    when presentOutputs([{ id: "markdown", label: "Notes", status: "ready", documents: [
      { path: "Book.md", mediaType: "text/markdown", content: "# Updated Book" }
    ] }])
    when selectOutput("markdown")
    then expectOutputLabels(["Notes"])
    then expectMarkdownHeadings(["Updated Book"])
  }

  scenario "closing the tabs leaves the host available to its owner" {
    given openOutputTabs()
    when presentOutputs(previews)
    when disposeOutputTabs()
    when disposeOutputTabs()
    then expectOutputLabels([])
    then expectOutputHostRetained()
  }

  scenario "preserve a selected output while it remains configured" {
    given openOutputTabs()
    when presentOutputs(previews)
    when selectOutput("markdown")
    when presentOutputs([{ id: "markdown", label: "Notes", status: "ready", documents: [
      { path: "Book.md", mediaType: "text/markdown", content: "# Updated Book" }
    ] }])
    then expectSelectedOutput("markdown")
    then expectMarkdownHeadings(["Updated Book"])
  }

  scenario "fall back to the first output when the selected ID is removed" {
    given openOutputTabs()
    when presentOutputs(previews)
    when selectOutput("typescript")
    when presentOutputs([{ id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "Book.md", mediaType: "text/markdown", content: "# Book" }
    ] }])
    then expectSelectedOutput("markdown")
    then expectMarkdownHeadings(["Book"])
  }

  scenario "readding a removed output does not resurrect its former selection" {
    given openOutputTabs()
    when presentOutputs(previews)
    when selectOutput("typescript")
    when presentOutputs([{ id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "Book.md", mediaType: "text/markdown", content: "# Book" }
    ] }])
    when presentOutputs(previews)
    then expectSelectedOutput("markdown")
    then expectMarkdownHeadings(["Book"])
  }

  scenario "pending feedback withdraws the previous document" {
    given openOutputTabs()
    when presentOutputs(previews)
    when selectOutput("typescript")
    when presentOutputs([{ id: "typescript", label: "TypeScript", status: "pending", documents: [], `message`: "Previewing current source." }])
    then expectOutputStatus("pending", "Previewing current source.")
  }

  scenario "show a refused output's actual explanation without documents" {
    given openOutputTabs()
    when presentOutputs([
      { id: "typescript", label: "TypeScript", status: "refused", documents: [], `message`: "invalid-native-mapping: Missing" },
      { id: "markdown", label: "Markdown", status: "ready", documents: [
        { path: "Book.md", mediaType: "text/markdown", content: "# Book" }
      ] }
    ])
    then expectOutputLabels(["TypeScript", "Markdown"])
    then expectOutputStatus("refused", "invalid-native-mapping: Missing")
  }

  scenario "a refused output leaves another output readable" {
    given openOutputTabs()
    when presentOutputs([
      { id: "typescript", label: "TypeScript", status: "refused", documents: [], `message`: "invalid-native-mapping: Missing" },
      { id: "markdown", label: "Markdown", status: "ready", documents: [
        { path: "Book.md", mediaType: "text/markdown", content: "# Book" }
      ] }
    ])
    when selectOutput("markdown")
    then expectOutputLabels(["TypeScript", "Markdown"])
    then expectMarkdownHeadings(["Book"])
  }

  scenario "open the supplied UML image instead of its earlier D2 source" {
    given openOutputTabs()
    when presentOutputs(diagrams)
    then expectSelectedDocument("structure.svg", ["structure.d2", "structure.svg"])
    then expectLoadedDiagram(100, 1800)
  }

  scenario "select real document paths within one output tab" {
    given openOutputTabs()
    when presentOutputs(diagrams)
    when selectOutputDocument("structure.svg")
    then expectSelectedDocument("structure.svg", ["structure.d2", "structure.svg"])
    then expectLoadedDiagram(100, 1800)
  }

  scenario "retain the selected SVG path across a changed presentation" {
    given openOutputTabs()
    when presentOutputs(diagrams)
    when selectOutputDocument("structure.svg")
    when presentOutputs(revisedDiagrams)
    then expectSelectedDocument("structure.svg", ["notes.d2", "structure.svg"])
    then expectLoadedDiagram(100, 1800)
  }

  scenario "removing the selected SVG falls back to the first retained document" {
    given openOutputTabs()
    when presentOutputs(diagrams)
    when selectOutputDocument("structure.svg")
    when presentOutputs(revisedDiagrams)
    when presentOutputs([{ id: "uml", label: "UML", status: "ready", documents: [
      { path: "notes.d2", mediaType: "text/vnd.d2", content: "Novel: { title: Number }" }
    ] }])
    when showOutputSource()
    then expectSelectedDocument("notes.d2", ["notes.d2"])
    then expectOutputContent("Novel: { title: Number }")
  }

  scenario "zoom and scroll a readable wide diagram" {
    given openOutputTabs()
    when presentOutputs(diagrams)
    when selectOutputDocument("structure.svg")
    when setDiagramZoom(150)
    when scrollDiagram(100, 80)
    then expectLoadedDiagram(150, 2700)
    then expectDiagramScroll(100, 80)
  }

  scenario "zoom and scroll a readable wide diagram then reset its scale" {
    given openOutputTabs()
    when presentOutputs(diagrams)
    when selectOutputDocument("structure.svg")
    when setDiagramZoom(150)
    when scrollDiagram(100, 80)
    when resetDiagramZoom()
    then expectLoadedDiagram(100, 1800)
  }

  scenario "ready with no authored documents is a visible successful empty result" {
    given openOutputTabs()
    when presentOutputs([{ id: "typescript", label: "TypeScript", status: "ready", documents: [], `message`: "No authored documents" }])
    then expectOutputStatus("ready", "No authored documents")
  }

  scenario "read headings lists tables and code as a Markdown document" {
    given openOutputTabs()
    when presentOutputs(readableMarkdown)
    then expectReadableMarkdown()
  }

  scenario "open Home before another supplied Markdown page without reordering paths" {
    given openOutputTabs()
    when presentOutputs(wikiPages)
    then expectSelectedDocument("docs/Home.md", ["docs/reference/Book.md", "docs/Home.md"])
    then expectMarkdownHeadings(["Library"])
    then expectDocumentTextAbsent("expec-section:")
    then expectDocumentTextAbsent("expec-end:")
  }

  scenario "follow supplied relative wiki pages and their actual anchors" {
    given openOutputTabs()
    when presentOutputs(wikiPages)
    when followDocumentLink("Read Book")
    when followDocumentLink("Book details")
    then expectSelectedDocument("docs/reference/Book.md", ["docs/reference/Book.md", "docs/Home.md"])
    then expectMarkdownHeadings(["Book", "Book details"])
    then expectDocumentAnchor("expec-626f6f6b")
    then expectSafePreview()
  }

  scenario "return to the supplied Home page through a relative parent link" {
    given openOutputTabs()
    when presentOutputs(wikiPages)
    when followDocumentLink("Read Book")
    when followDocumentLink("Home")
    then expectSelectedDocument("docs/Home.md", ["docs/reference/Book.md", "docs/Home.md"])
    then expectDocumentAnchor("expec-686f6d65")
    then expectSafePreview()
  }

  scenario "retain a selected wiki page when the output is presented again" {
    given openOutputTabs()
    when presentOutputs(wikiPages)
    when selectOutputDocument("docs/reference/Book.md")
    when presentOutputs(wikiPages)
    then expectSelectedDocument("docs/reference/Book.md", ["docs/reference/Book.md", "docs/Home.md"])
    then expectMarkdownHeadings(["Book", "Book details"])
  }

  scenario "show D2 source only after the author asks for it" {
    given openOutputTabs()
    when presentOutputs(previews)
    when showOutputSource()
    then expectOutputContent("Book: { title: Text }")
  }

  scenario "explain a missing rendered diagram without showing D2 source by default" {
    given openOutputTabs()
    when presentOutputs(previews)
    then expectDocumentExplanation("Diagram preview unavailable. Select an SVG document or show source.")
    then expectDocumentTextAbsent("Book: { title: Text }")
  }

  scenario "explain a missing anchor without leaving the supplied document" {
    given openOutputTabs()
    when presentOutputs(wikiPages)
    when followDocumentLink("Missing section")
    then expectDocumentExplanation("Anchor unavailable in supplied preview.")
    then expectSelectedDocument("docs/Home.md", ["docs/reference/Book.md", "docs/Home.md"])
    then expectSafePreview()
  }

  scenario "keep hostile HTML and resource links inert in a readable document" {
    given openOutputTabs()
    when presentOutputs([{ id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "Home.md", mediaType: "text/markdown", content: "# Safe document\n\n<script>window.expecPreviewUnsafe = true</script>\n\n<img src=\"https://example.invalid/pixel\" onerror=\"window.expecPreviewUnsafe = true\">\n\n![Book cover](https://example.invalid/cover.png)\n\n[Remote](https://example.invalid/)\n\n[Command](command:workbench.action.closeWindow)\n\n[Script](javascript:alert%281%29)\n\n[File](file:///tmp/book.md)\n\n[Missing](Missing.md#expec-626f6f6b)\n" }
    ] }])
    then expectMarkdownHeadings(["Safe document"])
    then expectInactiveDocumentLinks(["Remote", "Command", "Script", "File", "Missing"])
    then expectSafePreview()
  }

  scenario "keep fenced HTML visible as code without executing it" {
    given openOutputTabs()
    when presentOutputs([{ id: "markdown", label: "Markdown", status: "ready", documents: [
      { path: "Home.md", mediaType: "text/markdown", content: "# Example\n\n```html\n<script>window.expecPreviewUnsafe = true</script>\n```\n" }
    ] }])
    then expectMarkdownHeadings(["Example"])
    then expectMarkdownCodeBlocks(["<script>window.expecPreviewUnsafe = true</script>\n"])
    then expectSafePreview()
  }
  fixture promisedDiagram: List<OutputTab> = [
    { id: "uml", label: "UML", status: "ready", documents: [
      { path: "structure.svg", mediaType: "image/svg+xml", content: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"600\" viewBox=\"0 0 900 600\"><rect x=\"30\" y=\"60\" width=\"320\" height=\"40\" fill=\"white\"/><text x=\"40\" y=\"85\">export()</text><text x=\"40\" y=\"165\">download()</text></svg>",
        diagram: { width: 900, height: 600, `promises`: [
          { id: "export", label: "ResultsRelay.export", x: 30, y: 60, width: 320, height: 40, `promises`: ["Delivers the result", "Cleans temporary files"] },
          { id: "download", label: "ResultsRelay.download", x: 30, y: 140, width: 320, height: 40, `promises`: ["Supports cancellation"] }
        ] }
      }
    ] }
  ]
  fixture revisedPromisedDiagram: List<OutputTab> = [
    { id: "uml", label: "UML", status: "ready", documents: [
      { path: "structure.svg", mediaType: "image/svg+xml", content: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"600\" viewBox=\"0 0 900 600\"><rect x=\"30\" y=\"60\" width=\"320\" height=\"40\" fill=\"white\"/><text x=\"40\" y=\"85\">export()</text><text x=\"40\" y=\"165\">download()</text></svg>",
        diagram: { width: 900, height: 600, `promises`: [
          { id: "export", label: "ResultsRelay.export", x: 30, y: 60, width: 320, height: 40, `promises`: ["Reports delivery progress"] },
          { id: "download", label: "ResultsRelay.download", x: 30, y: 140, width: 320, height: 40, `promises`: ["Supports cancellation"] }
        ] }
      }
    ] }
  ]
  fixture unsafePromisedDiagram: List<OutputTab> = [
    { id: "uml", label: "UML", status: "ready", documents: [
      { path: "structure.svg", mediaType: "image/svg+xml", content: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"600\" viewBox=\"0 0 900 600\"><rect x=\"30\" y=\"60\" width=\"320\" height=\"40\" fill=\"white\"/><text x=\"40\" y=\"85\">export()</text><text x=\"40\" y=\"165\">download()</text></svg>",
        diagram: { width: 900, height: 600, `promises`: [
          { id: "export", label: "ResultsRelay.export", x: 30, y: 60, width: 320, height: 40, `promises`: ["<img src=\"https://example.invalid/promise\" onerror=\"window.expecPreviewUnsafe = true\">", "**Keep this literal**"] },
          { id: "download", label: "ResultsRelay.download", x: 30, y: 140, width: 320, height: 40, `promises`: ["Supports cancellation"] }
        ] }
      }
    ] }
  ]
  action hoverPromiseBubble() returns Nothing
  action hoverPromise(label: Text) returns Nothing
  action focusPromise(label: Text) returns Nothing
  action pinPromise(label: Text) returns Nothing
  action pressPromiseKey(key: Text) returns Nothing
  action leavePromises() returns Nothing
  action clickOutsidePromises() returns Nothing
  observation promiseIndicatorLabels() returns List<Text>
  observation visiblePromiseLabel() returns Text
  observation visiblePromiseTexts() returns List<Text>
  observation pinnedPromiseLabel() returns Text
  observation promiseIndicatorAligned(label: Text) returns Boolean
  check expectPromiseBubble(label: Text, texts: List<Text>, pinned: Text) {
    let actualLabel = visiblePromiseLabel()
    let actualTexts = visiblePromiseTexts()
    let actualPinned = pinnedPromiseLabel()
    assert actualLabel == label
    assert actualTexts == texts
    assert actualPinned == pinned
  }
  check expectPromiseIndicators(labels: List<Text>) {
    let actual = promiseIndicatorLabels()
    assert actual == labels
  }
  check expectPromiseAlignment(label: Text) {
    let actual = promiseIndicatorAligned(label)
    assert actual == true
  }
  scenario "keep promise text hidden until inspected" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    then expectPromiseIndicators(["ResultsRelay.export: 2 promises", "ResultsRelay.download: 1 promise"])
    then expectPromiseBubble("", [], "")
  }
  scenario "inspect a capability by hovering its promise indicator" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when hoverPromise("ResultsRelay.export")
    then expectPromiseBubble("ResultsRelay.export", ["Delivers the result", "Cleans temporary files"], "")
  }
  scenario "close an unpinned thought bubble when leaving it" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when hoverPromise("ResultsRelay.export")
    when leavePromises()
    then expectPromiseBubble("", [], "")
  }
  scenario "inspect a capability by keyboard focus" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when focusPromise("ResultsRelay.export")
    then expectPromiseBubble("ResultsRelay.export", ["Delivers the result", "Cleans temporary files"], "")
  }
  scenario "pin a promise bubble with Enter" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when focusPromise("ResultsRelay.export")
    when pressPromiseKey("Enter")
    when leavePromises()
    then expectPromiseBubble("ResultsRelay.export", ["Delivers the result", "Cleans temporary files"], "ResultsRelay.export")
  }
  scenario "close pinned promises with Escape while focus remains on the control" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when focusPromise("ResultsRelay.export")
    when pressPromiseKey("Enter")
    when pressPromiseKey("Escape")
    then expectPromiseBubble("", [], "")
  }
  scenario "keep pinned promises while hovering another capability" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when hoverPromise("ResultsRelay.download")
    then expectPromiseBubble("ResultsRelay.export", ["Delivers the result", "Cleans temporary files"], "ResultsRelay.export")
  }
  scenario "replace a pinned promise bubble by clicking another capability" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when pinPromise("ResultsRelay.download")
    then expectPromiseBubble("ResultsRelay.download", ["Supports cancellation"], "ResultsRelay.download")
  }
  scenario "close pinned promises with an outside click" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when clickOutsidePromises()
    then expectPromiseBubble("", [], "")
  }
  scenario "toggle pinned promises closed by clicking the same indicator" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when pinPromise("ResultsRelay.export")
    then expectPromiseBubble("", [], "")
  }
  scenario "keep promise controls aligned while zooming and scrolling" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when setDiagramZoom(150)
    when scrollDiagram(120, 60)
    then expectPromiseAlignment("ResultsRelay.export")
  }
  scenario "restore promise alignment when resetting zoom" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when setDiagramZoom(150)
    when resetDiagramZoom()
    then expectPromiseAlignment("ResultsRelay.export")
  }
  scenario "clear pinned promises when replacing the document" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when presentOutputs(diagrams)
    then expectPromiseBubble("", [], "")
    then expectPromiseIndicators([])
  }
  scenario "clear pinned promises when only annotations change" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when presentOutputs(revisedPromisedDiagram)
    then expectPromiseBubble("", [], "")
  }
  scenario "show updated promises for an unchanged image" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when pinPromise("ResultsRelay.export")
    when presentOutputs(revisedPromisedDiagram)
    when hoverPromise("ResultsRelay.export")
    then expectPromiseBubble("ResultsRelay.export", ["Reports delivery progress"], "")
  }
  scenario "keep the thought bubble open while reading its content" {
    given openOutputTabs()
    when presentOutputs(promisedDiagram)
    when hoverPromise("ResultsRelay.export")
    when hoverPromiseBubble()
    then expectPromiseBubble("ResultsRelay.export", ["Delivers the result", "Cleans temporary files"], "")
  }
  scenario "keep promise HTML and Markdown literal and inert" {
    given openOutputTabs()
    when presentOutputs(unsafePromisedDiagram)
    when hoverPromise("ResultsRelay.export")
    then expectPromiseBubble("ResultsRelay.export", ["<img src=\"https://example.invalid/promise\" onerror=\"window.expecPreviewUnsafe = true\">", "**Keep this literal**"], "")
    then expectSafePreview()
  }

}

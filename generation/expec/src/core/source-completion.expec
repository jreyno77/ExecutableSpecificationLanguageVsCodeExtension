// EXT-10 completes an existing final named-type token from one current publication.
// Boo also matches builtin Boolean; independent eligible names survive bad imports.
// The full reviewed CORE-36 development SDK capture cecb20e supplies typeCandidates;
// language CI and exact package delivery remain separate from this capture.
use SourceDocument from "./workspace.expec"
use DocumentReport from "./document-analysis.expec"

type TypeSuggestion {
  spelling: Text
  insertionText: Text
  targetName: Text
}
type TypeCompletion {
  source: SourceDocument
  startOffset: Number
  endOffset: Number
  suggestions: List<TypeSuggestion>
}

component SourceCompletion {
  requires package "expec" for runtime
  requires package "typescript" for build
  requires package "vitest" for test
  construction()
  public published, closed, completion, dispose

  capability published(source: SourceDocument, version: Number, report: DocumentReport) returns Nothing {
    promises "Receive the same current immutable DocumentAnalysis publication used by diagnostics, navigation, hover and outline, including replacement at the same editor version after an imported source changes. Reject negative or noninteger versions before changing state. The caller excludes an earlier document lifetime. Retain this exact source/version. Prepare only current Inspection references whose immediate parent is named-type and whose final segment has a safe single-line source range in this captured requesting text. Ask public typeCandidates with this report's same Resolution and that exact reference id once for each such reference, and read each actual target through this same Inspection. Preserve independently eligible candidates even when other compilation or candidate findings exist; no value for a missing/deferred/invalid qualifier gives no completion. Never enumerate global types to reconstruct resolver visibility, parse, compose, compile, acquire files or install packages. Absent current Inspection/Resolution or rejected entry syntax withdraws old completion facts. A valid current publication withdraws its previous prepared facts before preparation: genuine malformed/foreign Resolution or Inspection caller errors surface through the existing SDK error rather than being swallowed, retried, blended with another report or leaving old facts usable at the same editor version."
  }
  capability closed(uri: Text) returns Nothing {
    promises "Forget only this exact document's prepared completion facts. Repeated close is harmless. A later current publication starts a new lifetime and may use a lower editor version."
  }
  capability completion(uri: Text, version: Number, offset: Number) returns TypeCompletion? {
    promises "Reject negative or noninteger versions/Unicode-scalar offsets with RangeError. Ask only prepared facts for the exact URI/version. Return absence after close/disposal, for a stale version, outside the captured text, without a current named-type final token or without a value from its contextual candidate query. Cursor positions within or immediately after that token are allowed; qualified prefixes, separators, comments, declaration names and values are not contexts. Replace the whole final token's half-open scalar range, including quotes where authored, never the qualifier. Filter eligible decoded names by case-sensitive startsWith of the complete decoded final token, then order by deterministic decoded-name code-unit comparison. Return each exact eligible spelling, the SDK's insertionText, and its actual target's decoded name; aliases keep their eligible spelling distinct from their target name. Empty matching names may give a current reply with an empty list. Do not infer generic arguments, arity correctness, runtime behavior or successful compilation. A request performs no Inspection/query traversal, candidate query, parsing, resolution, compilation, acquisition, generation, disk writes or editor changes."
  }
  capability dispose() returns Nothing {
    promises "Clear this completion lifetime and ignore later publications. Queries return absence and repeated disposal is harmless. No files or native resources are owned."
  }
}

// Real DocumentAnalysis and in-memory saved sources publish to SourceCompletion.
// Request numbers retain actual replies; missing requests cannot count as empty.
// Work observations record actual reader/compiler/source/Inspection/candidate calls.
examples for SourceCompletion {
  setup sourceCompletions() returns Nothing
  action saveCompletionSource(source: SourceDocument) returns Nothing
  action openCompletionSource(source: SourceDocument, version: Number) returns Nothing
  action changeCompletionSource(source: SourceDocument, version: Number) returns Nothing
  action closeCompletionSource(uri: Text) returns Nothing
  action requestTypeCompletion(uri: Text, version: Number, line: Number, column: Number) returns Nothing
  action rememberCompletionWork() returns Nothing
  observation hasTypeCompletion(request: Number) returns Boolean
  observation typeSuggestionCount(request: Number) returns Number
  observation typeSuggestionSpelling(request: Number, index: Number) returns Text
  observation typeSuggestionInsertion(request: Number, index: Number) returns Text
  observation typeSuggestionTarget(request: Number, index: Number) returns Text
  observation typeCompletionText(request: Number) returns Text
  observation typeCompletionStartLine(request: Number) returns Number
  observation typeCompletionStartColumn(request: Number) returns Number
  observation typeCompletionEndLine(request: Number) returns Number
  observation typeCompletionEndColumn(request: Number) returns Number
  observation completionWorkUnchanged() returns Boolean

  check expectTypeSuggestions(request: Number, count: Number) {
    let actual = typeSuggestionCount(request)
    assert actual == count
  }
  check expectTypeCompletionAvailable(request: Number, available: Boolean) {
    let actual = hasTypeCompletion(request)
    assert actual == available
  }
  check expectTypeSuggestion(request: Number, index: Number, spelling: Text, insertion: Text, target: Text) {
    let actualSpelling = typeSuggestionSpelling(request, index)
    let actualInsertion = typeSuggestionInsertion(request, index)
    let actualTarget = typeSuggestionTarget(request, index)
    assert actualSpelling == spelling
    assert actualInsertion == insertion
    assert actualTarget == target
  }
  check expectTypeReplacement(request: Number, text: Text, line: Number, start: Number, end: Number) {
    let actualText = typeCompletionText(request)
    let actualLine = typeCompletionStartLine(request)
    let actualStart = typeCompletionStartColumn(request)
    let actualEndLine = typeCompletionEndLine(request)
    let actualEnd = typeCompletionEndColumn(request)
    assert actualText == text
    assert actualLine == line
    assert actualStart == start
    assert actualEndLine == line
    assert actualEnd == end
  }
  check expectNoCompletionWork() {
    let unchanged = completionWorkUnchanged()
    assert unchanged == true
  }

  scenario "the actual type scope offers Book and Boolean and excludes another owner's local Bookcase" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\ncomponent Store {\n  local type Bookcase {}\n}\ntype Basket { book: Boo }" }, 1)
    when rememberCompletionWork()
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 5, 24)
    then expectTypeCompletionAvailable(1, true)
    then expectTypeSuggestions(1, 2)
    then expectTypeSuggestion(1, 1, "Book", "Book", "Book")
    then expectTypeSuggestion(1, 2, "Boolean", "Boolean", "Boolean")
    then expectTypeReplacement(1, "type Book {}\ncomponent Store {\n  local type Bookcase {}\n}\ntype Basket { book: Boo }", 5, 21, 24)
    then expectNoCompletionWork()
  }
  scenario "an eligible imported alias keeps Novel distinct from its Book target" {
    given sourceCompletions()
    when saveCompletionSource({ uri: "file:///workspace/book.expec", text: "type Book {}" })
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "use Book as Novel from \"./book.expec\"\ntype Basket { book: Nov }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    then expectTypeSuggestions(1, 1)
    then expectTypeSuggestion(1, 1, "Novel", "Novel", "Book")
  }
  scenario "an own qualified type replaces only Boo while its Library prefix has no completion" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/library.expec", text: "component Library {\n  local type Book {}\n  capability read(book: Library.Boo)\n}" }, 1)
    when requestTypeCompletion("file:///workspace/library.expec", 1, 3, 36)
    when requestTypeCompletion("file:///workspace/library.expec", 1, 3, 26)
    then expectTypeCompletionAvailable(1, true)
    then expectTypeSuggestions(1, 1)
    then expectTypeSuggestion(1, 1, "Book", "Book", "Book")
    then expectTypeReplacement(1, "component Library {\n  local type Book {}\n  capability read(book: Library.Boo)\n}", 3, 33, 36)
    then expectTypeCompletionAvailable(2, false)
    then expectTypeSuggestions(2, 0)
  }
  scenario "a current context with no matching spelling has a present empty reply" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\ntype Basket { book: Zoo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    then expectTypeCompletionAvailable(1, true)
    then expectTypeSuggestions(1, 0)
  }
  scenario "a missing qualifier has no reply instead of falling back to global Book" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\ntype Basket { book: Missing.Boo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 32)
    then expectTypeCompletionAvailable(1, false)
    then expectTypeSuggestions(1, 0)
  }
  scenario "a missing include retains deferred composition instead of inventing candidates" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "include \"./missing.expec\"\ntype Basket { book: Boo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    then expectTypeCompletionAvailable(1, false)
    then expectTypeSuggestions(1, 0)
  }
  scenario "unsaved source replaces suggestions and an older version has none" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\ntype Basket { book: Boo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    when changeCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Booklet {}\ntype Basket { book: Boo }" }, 2)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    when requestTypeCompletion("file:///workspace/basket.expec", 2, 2, 24)
    then expectTypeSuggestion(1, 1, "Book", "Book", "Book")
    then expectTypeCompletionAvailable(2, false)
    then expectTypeSuggestions(2, 0)
    then expectTypeSuggestion(3, 1, "Booklet", "Booklet", "Booklet")
  }
  scenario "an unsaved imported replacement withdraws Book at the same entry version" {
    given sourceCompletions()
    when saveCompletionSource({ uri: "file:///workspace/book.expec", text: "type Book {}" })
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "use Book from \"./book.expec\"\ntype Basket { book: Boo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    when openCompletionSource({ uri: "file:///workspace/book.expec", text: "type Magazine {}" }, 2)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    then expectTypeSuggestion(1, 1, "Book", "Book", "Book")
    then expectTypeCompletionAvailable(2, true)
    then expectTypeSuggestions(2, 1)
    then expectTypeSuggestion(2, 1, "Boolean", "Boolean", "Boolean")
  }
  scenario "ambiguous imported spellings do not choose the first Book" {
    given sourceCompletions()
    when saveCompletionSource({ uri: "file:///workspace/first.expec", text: "type Book {}" })
    when saveCompletionSource({ uri: "file:///workspace/second.expec", text: "type Book {}" })
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "use Book from \"./first.expec\"\nuse Book from \"./second.expec\"\ntype Basket { book: Boo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 3, 24)
    then expectTypeCompletionAvailable(1, true)
    then expectTypeSuggestions(1, 1)
    then expectTypeSuggestion(1, 1, "Boolean", "Boolean", "Boolean")
  }
  scenario "rejected text withdraws old suggestions instead of using the previous model" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\ntype Basket { book: Boo }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    when changeCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\ntype Basket { book: Boo" }, 2)
    when requestTypeCompletion("file:///workspace/basket.expec", 2, 2, 24)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 24)
    then expectTypeSuggestion(1, 1, "Book", "Book", "Book")
    then expectTypeCompletionAvailable(2, false)
    then expectTypeCompletionAvailable(3, false)
    then expectTypeSuggestions(2, 0)
    then expectTypeSuggestions(3, 0)
  }
  scenario "a promise string is not a type-completion context" {
    given sourceCompletions()
    when openCompletionSource({ uri: "file:///workspace/basket.expec", text: "type Book {}\nfunction publish() returns Text { promises \"Boo\" }" }, 1)
    when requestTypeCompletion("file:///workspace/basket.expec", 1, 2, 47)
    then expectTypeCompletionAvailable(1, false)
    then expectTypeSuggestions(1, 0)
  }
}


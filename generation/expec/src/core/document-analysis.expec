use SourceDocument from "./workspace.expec"
use ConnectionConfiguration from "./project-connection.expec"

// The language's existing SyntaxDiagnostic: category, explanation, primaryRange
// and relatedRanges. Locations count Unicode scalars; no VS Code/LSP types live here.
opaque type SyntaxProblem
// The existing compiler Compilation, including problems, deferred requirements and
// optional checked Specification. Preserve it rather than inventing another model.
opaque type CompilerReport
// Public SDK Inspection over this publication's same composed resolution model.
// Bound facts can be useful despite independent problems; this is not Specification.
opaque type SourceInspection
// The exact public SDK Resolution supplied to Compiler and this same Inspection.
// Keep this core evidence opaque; no native transport exposes its model.
opaque type SourceResolution
// Existing public SDK facts, including their manifest/source-mapping origins.
opaque type ScopedPackageRequirement
opaque type DependencyDiagnostic

type DocumentReport {
  syntax: List<SyntaxProblem>
  compilation: CompilerReport?
  inspection: SourceInspection?
  resolution: SourceResolution?
  sources: List<SourceDocument>
  dependencies: List<Text>
  requirements: List<ScopedPackageRequirement>?
  dependencyProblems: List<DependencyDiagnostic>?
}

interface DocumentSources {
  public read, localPath
  capability read(uri: Text) returns SourceDocument? {
    promises "Return the current saved text with this exact URI, or absence when unavailable. Do not discover projects, install dependencies or substitute empty text. Unexpected acquisition errors surface. Core overrides this saved snapshot with an open document's unsaved text."
  }
  capability localPath(uri: Text, manifestFile: Text) returns Text? {
    promises "Return the verified portable source path relative to this selected manifest's directory, using the exact supplied source URI and native root/file ancestry facts. A named unsaved file under verified existing ancestors can have a path without reading or creating its contents. A foreign route, unsupported URI, unavailable root or route escaping the verified root has no local path; never strip a URI prefix or guess ownership from declarations, folders, generated destinations or build.sourceRoots. A nested source root cannot shorten the primary manifest-relative path. Core supplies its exact captured sourceId separately. Unexpected provider errors surface. This query does not scan, install, capture a connected project or write."
  }
}

interface DocumentFeedback {
  public publish, clear

  capability publish(source: SourceDocument, version: Number, report: DocumentReport) returns Nothing {
    promises "Every DocumentAnalysis publication includes detached immutable requirements and dependencyProblems lists prepared through the public requirementsFor and ConfigurationReader. Keep the compiler Compilation unchanged; configuration and source-ownership findings retain their actual dependency origins separately. Empty lists mean no effective scoped obligations or findings, not proof of installation. The additive optional report fields support older supplied-report consumers; this analysis always supplies both. Caller mutation cannot change an earlier or current report."
    promises "Publish the report for this exact immutable snapshot and version. Preserve actual reader diagnostics and the complete compiler result, including nonlocated problems and deferred requirements. Compilation is absent for rejected entry syntax. Inspection is absent for rejected entry syntax; otherwise it is a public QueryInspection over the same SourceComposer Resolution.model passed to Compiler, captured once without another resolution pass. It preserves bound, invalid and deferred reference facts even when Compilation has problems or no Specification. Never retain an older Inspection after rejection. Sources are the captured texts used for located findings; dependencies are exact source URIs requested, including unavailable imports. An empty diagnostic result replaces previous problems; absence of problems alone does not establish compilation success."
    promises "Retain that exact immutable SourceComposer Resolution in this report, captured once and passed to Compiler and the same QueryInspection before publication. Resolution is absent for rejected entry syntax; never retain an earlier accepted resolution after rejection. Current independently bound facts remain usable despite unrelated compiler problems or absent Specification. Completion consumes this same core evidence without another resolution pass; no Resolution or model crosses the native protocol boundary."
  }

  capability clear(uri: Text) returns Nothing {
    promises "Remove all diagnostic feedback for this exact document URI."
  }
}

component DocumentAnalysis {
  requires package "expec" for runtime

  construction(feedback: DocumentFeedback, sources: DocumentSources)
  public opened, changed, closed, sourceChanged, configurationChanged

  capability configurationChanged(configuration: ConnectionConfiguration?) returns Nothing {
    promises "Receive the current selected saved configuration snapshot or absence. Validate its supplied text through the public ConfigurationReader with shipped output profiles, then capture only validated Configuration.packages aliases and phases as the existing SourceComposer's DependencyPackage inputs. Missing text, invalid configuration, switching manifests or withdrawing selection replaces the prior catalog; never retain old supplied packages after an invalid or absent snapshot. Do not use writable as package availability or read unsaved configuration buffers; ConnectionSidebar supplies its actual saved-text policy. These are supplied compiler configuration facts, not proof of package installation, native exports, external declaration models, runtime behavior or generation readiness. Keep genuinely unsupplied aliases and missing phases as the language's actual findings. Do not infer packages from imports, folder names, node_modules or another project."
    promises "A changed catalog invalidates current open analyses and republishes their exact retained unsaved sources at unchanged editor versions through the same SourceComposer, Compiler and Inspection/Resolution publication. Reuse unchanged parsed sources and saved dependency snapshots. Retain the validated catalog for ordinary source edits rather than revalidating configuration per edit. Preserve current document lifetimes and guard reentrant source/configuration/feedback changes so older work cannot publish with an obsolete catalog. Validation or publication exceptions surface; they are not empty success. Existing configuration consumers retain actual validation explanations. This operation never acquires project/package code, scans, installs, generates, saves or writes; it does not require connected-target verification."
    promises "Retain the validated requirements metadata with the same catalog, and include the selected manifest filename and effective scope metadata in configuration currentness even when aliases/phases are unchanged. Prepare requirementsFor over the actual captured workspace source identities and provider-supplied local paths; no resolver, synthetic model or implicit runtime imports are added. Project obligations apply to supplied workspace sources even when a foreign or untitled source has no local path; folder/exact-file obligations require verified local paths. Do not treat acquired external declaration models as workspace sources. Invalid or absent configuration withdraws earlier rows/catalog and publishes the actual configuration findings; failed scope preparation publishes no old rows. A relevant saved scope change rechecks retained unsaved text at the same editor version. Cache source ownership between text edits; invalidate it after a selected configuration change or relevant source-route notification, guard reentrant provider/feedback callbacks, and never run SourceLoader or connected native capture on each keystroke."
  }

  capability opened(source: SourceDocument, version: Number) returns Nothing {
    promises "Start an open document lifetime from this exact supplied snapshot. Use one retained LangiumReader and Compiler; compose accepted source models through the existing SourceComposer. Resolve authored source locators relative to their owner URI and obtain only required source snapshots through DocumentSources. Absolute URIs remain usable; a relative locator without a hierarchical owner, including untitled, remains an unavailable-module finding without guessing a workspace or throwing a URL-base error. Open unsaved text overrides saved text. Cache parsing by exact text, including rejected text; never reuse a previous accepted model after invalid edits. Publish real syntax and compiler findings without generating, installing packages or requiring a project connection. No runtime package facts are invented; unavailable prerequisites remain explicit. Treat URIs as identity. Reject invalid noninteger or negative versions with RangeError before changing state."
  }

  capability changed(source: SourceDocument, version: Number) returns Nothing {
    promises "Reject a noninteger or negative version with a RangeError before changing state. For an open document, check and publish only a strictly newer version. Ignore duplicate, older and unopened-document changes. Retain the exact snapshot and version for publication. Update affected open dependents as well. Check that the same lifetime, version and dependency revision remain current before publishing after reentrant source or feedback callbacks. The native caller excludes callbacks from an earlier document lifetime; URI/version alone cannot distinguish those after reopening. Syntax acceptance makes no semantic validity claim; retain compiler problems and deferred requirements. Reader or publication exceptions must surface rather than masquerade as an empty successful result."
  }

  capability closed(uri: Text) returns Nothing {
    promises "End this open lifetime and clear its diagnostics. Ignore later changes until the document is opened again; reopening may start with a lower version. Repeated close is harmless. Imported closed documents fall back to current saved text, and affected open dependents are rechecked. Unrelated documents remain unchanged."
  }
  capability sourceChanged(uri: Text) returns Nothing {
    promises "Invalidate a requested saved source after creation, change or deletion and recheck affected open entries even when their editor version is unchanged. Ignore unrelated URIs and saved changes hidden by an authoritative open snapshot. Reuse unchanged parsed snapshots and read only the invalidated source plus newly required imports. Track missing imports too, and terminate cyclic import acquisition. Preserve other documents and previous reports; do not let reentrant older work replace current feedback."
    promises "When folder/file scopes are in use, a relevant file-route notification also invalidates the cached local-path fact, including for authoritative open unsaved text. Recheck the same retained snapshot if its effective scope ownership changed; do not replace that text with saved bytes. Include actually queried ownership URIs in dependencies so the existing native watch boundary can invalidate them. Unrelated notifications cannot trigger a scan or reset another document's facts."
  }
}

// These exercise real DocumentAnalysis and the real language reader with a recording
// DocumentFeedback and an in-memory DocumentSources. Observations read real published
// reports/clears; they do not parse text or recreate compiler decisions.
// Reader checking is synchronous today; older queued callbacks must still be ignored.
examples for DocumentAnalysis {
  fixture broken: SourceDocument = {
    uri: "file:///workspace/src/library.expec",
    text: "type Book {\n  title: Text\n"
  }
  fixture corrected: SourceDocument = {
    uri: "file:///workspace/src/library.expec",
    text: "type Book {\n  title: Text\n}"
  }
  fixture other: SourceDocument = {
    uri: "untitled:Untitled-1",
    text: "type Draft { value: Unknown }"
  }

  setup syntaxAnalysis() returns Nothing
  action openSource(source: SourceDocument, version: Number) returns Nothing
  action changeSource(source: SourceDocument, version: Number) returns Nothing
  action closeSource(uri: Text) returns Nothing
  observation publishedVersion(uri: Text) returns Number
  observation publicationCount(uri: Text) returns Number
  observation syntaxProblemCount(uri: Text) returns Number
  observation syntaxExplanation(uri: Text) returns Text
  observation syntaxStartLine(uri: Text) returns Number
  observation syntaxStartColumn(uri: Text) returns Number
  observation syntaxEndLine(uri: Text) returns Number
  observation syntaxEndColumn(uri: Text) returns Number
  observation clearCount(uri: Text) returns Number
  action tryOpeningSource(source: SourceDocument, version: Number) returns Nothing
  action tryChangingSource(source: SourceDocument, version: Number) returns Nothing
  // Try actions invoke the named real method and record whether it throws RangeError.
  observation invalidVersionRejected() returns Boolean

  check expectSyntaxProblem(uri: Text, version: Number, line: Number, column: Number) {
    let actualVersion = publishedVersion(uri)
    let count = syntaxProblemCount(uri)
    let explanation = syntaxExplanation(uri)
    let startLine = syntaxStartLine(uri)
    let startColumn = syntaxStartColumn(uri)
    let endLine = syntaxEndLine(uri)
    let endColumn = syntaxEndColumn(uri)
    assert actualVersion == version
    assert count == 1
    assert explanation != ""
    assert startLine == line
    assert startColumn == column
    assert endLine == line
    assert endColumn == column
  }
  check expectNoSyntaxProblems(uri: Text, version: Number) {
    let actualVersion = publishedVersion(uri)
    let count = syntaxProblemCount(uri)
    assert actualVersion == version
    assert count == 0
  }
  check expectPublications(uri: Text, expected: Number) {
    let actual = publicationCount(uri)
    assert actual == expected
  }
  check expectClears(uri: Text, expected: Number) {
    let actual = clearCount(uri)
    assert actual == expected
  }

  check expectInvalidVersionRejected() {
    let rejected = invalidVersionRejected()
    assert rejected == true
  }

  scenario "locate a missing closing brace at the end of the supplied text" {
    given syntaxAnalysis()
    when openSource(broken, 1)
    then expectSyntaxProblem(broken.uri, 1, 3, 1)
  }
  scenario "correcting unsaved text replaces the previous syntax problem" {
    given syntaxAnalysis()
    when openSource(broken, 1)
    when changeSource(corrected, 2)
    then expectNoSyntaxProblems(corrected.uri, 2)
    then expectPublications(corrected.uri, 2)
  }
  scenario "older and duplicate document versions cannot replace current feedback" {
    given syntaxAnalysis()
    when openSource(broken, 1)
    when changeSource(corrected, 3)
    when changeSource(broken, 2)
    when changeSource(broken, 3)
    then expectNoSyntaxProblems(corrected.uri, 3)
    then expectPublications(corrected.uri, 2)
  }
  scenario "closing clears feedback and ignores later document changes" {
    given syntaxAnalysis()
    when openSource(broken, 1)
    when closeSource(broken.uri)
    when closeSource(broken.uri)
    when changeSource(corrected, 2)
    then expectClears(broken.uri, 1)
    then expectPublications(broken.uri, 1)
  }
  scenario "reopening starts a new document lifetime with its own version" {
    given syntaxAnalysis()
    when openSource(broken, 10)
    when closeSource(broken.uri)
    when openSource(corrected, 1)
    then expectNoSyntaxProblems(corrected.uri, 1)
    then expectPublications(corrected.uri, 2)
  }
  scenario "syntax feedback does not claim that an unresolved type is invalid syntax" {
    given syntaxAnalysis()
    when openSource(other, 1)
    then expectNoSyntaxProblems(other.uri, 1)
  }
  scenario "closing one document leaves another document's feedback intact" {
    given syntaxAnalysis()
    when openSource(broken, 1)
    when openSource(other, 1)
    when closeSource(other.uri)
    then expectSyntaxProblem(broken.uri, 1, 3, 1)
    then expectClears(broken.uri, 0)
    then expectClears(other.uri, 1)
  }
  scenario "reject negative document versions without publishing" {
    given syntaxAnalysis()
    when tryOpeningSource(broken, -1)
    then expectInvalidVersionRejected()
    then expectPublications(broken.uri, 0)
  }
  scenario "reject fractional versions without changing existing feedback" {
    given syntaxAnalysis()
    when openSource(corrected, 1)
    when tryChangingSource(broken, 1.5)
    then expectInvalidVersionRejected()
    then expectNoSyntaxProblems(corrected.uri, 1)
    then expectPublications(corrected.uri, 1)
  }
  // Semantic setup creates a fresh real analysis with saved-source snapshots. All
  // observations below read its actual Compilation; hasCheckedSpecification tests value.
  setup semanticAnalysis() returns Nothing
  action saveSemanticSource(source: SourceDocument) returns Nothing
  action removeSemanticSource(uri: Text) returns Nothing
  action openSemanticSource(source: SourceDocument, version: Number) returns Nothing
  action changeSemanticSource(source: SourceDocument, version: Number) returns Nothing
  action closeSemanticSource(uri: Text) returns Nothing
  observation semanticProblemCode(uri: Text) returns Text
  observation semanticProblemCount(uri: Text) returns Number
  observation semanticStartLine(uri: Text) returns Number
  observation semanticStartColumn(uri: Text) returns Number
  observation semanticEndColumn(uri: Text) returns Number
  observation hasCheckedSpecification(uri: Text) returns Boolean
  observation semanticDeferredCount(uri: Text) returns Number
  observation semanticPublicationCount(uri: Text) returns Number
  observation semanticPublishedVersion(uri: Text) returns Number

  fixture basket: SourceDocument = {
    uri: "file:///workspace/src/basket.expec",
    text: "use Book from \"./book.expec\"\ntype Basket { book: Book }"
  }
  fixture book: SourceDocument = {
    uri: "file:///workspace/src/book.expec",
    text: "type Book { title: Text }"
  }
  fixture renamedBook: SourceDocument = {
    uri: "file:///workspace/src/book.expec",
    text: "type Magazine { title: Text }"
  }

  fixture packageView: SourceDocument = {
    uri: "file:///workspace/src/view.expec",
    text: "component ReactView { requires package \"react\" for runtime }"
  }
  fixture runtimePackages: ConnectionConfiguration = {
    file: "C:/workspace/expec.json",
    text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/view.expec\"]},\"outputs\":[],\"packages\":[{\"alias\":\"react\",\"name\":\"npm:react\",\"version\":\"19.3.0\",\"phases\":[\"runtime\"]}]}",
    writable: true
  }
  fixture testPackages: ConnectionConfiguration = {
    file: "C:/workspace/expec.json",
    text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/view.expec\"]},\"outputs\":[],\"packages\":[{\"alias\":\"react\",\"name\":\"npm:react\",\"version\":\"19.3.0\",\"phases\":[\"test\"]}]}",
    writable: true
  }

  // Forward real saved snapshots to this same analysis. Historical observations
  // read actual recorded Compilation reports, never recompute package policy.
  action changeSemanticConfiguration(configuration: ConnectionConfiguration) returns Nothing
  action clearSemanticConfiguration() returns Nothing
  observation semanticProblemAtPublication(uri: Text, publication: Number) returns Text
  observation checkedAtPublication(uri: Text, publication: Number) returns Boolean
  check expectEarlierPackageProblem(uri: Text, publication: Number) {
    let code = semanticProblemAtPublication(uri, publication)
    let checked = checkedAtPublication(uri, publication)
    assert code == "unavailable-package"
    assert checked == false
  }
  check expectEarlierCheckedPackageSource(uri: Text, publication: Number) {
    let checked = checkedAtPublication(uri, publication)
    assert checked == true
  }

  check expectSemanticProblem(uri: Text, code: Text, line: Number, column: Number, endColumn: Number) {
    let actualCode = semanticProblemCode(uri)
    let count = semanticProblemCount(uri)
    let actualLine = semanticStartLine(uri)
    let actualColumn = semanticStartColumn(uri)
    let actualEnd = semanticEndColumn(uri)
    let checked = hasCheckedSpecification(uri)
    assert actualCode == code
    assert count == 1
    assert actualLine == line
    assert actualColumn == column
    assert actualEnd == endColumn
    assert checked == false
  }
  check expectCheckedSource(uri: Text) {
    let checked = hasCheckedSpecification(uri)
    let problems = semanticProblemCount(uri)
    let deferred = semanticDeferredCount(uri)
    assert checked == true
    assert problems == 0
    assert deferred == 0
  }
  check expectSemanticPublications(uri: Text, count: Number, version: Number) {
    let actualCount = semanticPublicationCount(uri)
    let actualVersion = semanticPublishedVersion(uri)
    assert actualCount == count
    assert actualVersion == version
  }

  scenario "an unknown type is a semantic problem rather than invalid syntax" {
    given semanticAnalysis()
    when openSemanticSource({ uri: "untitled:Draft", text: "type Basket { book: Boook }" }, 1)
    then expectSemanticProblem("untitled:Draft", "unresolved-reference", 1, 21, 26)
    then expectNoSyntaxProblems("untitled:Draft", 1)
  }
  scenario "fixing an unsaved unknown type produces a checked specification" {
    given semanticAnalysis()
    when openSemanticSource({ uri: "untitled:Draft", text: "type Basket { book: Boook }" }, 1)
    when changeSemanticSource({ uri: "untitled:Draft", text: "type Basket { book: Text }" }, 2)
    then expectCheckedSource("untitled:Draft")
    then expectSemanticPublications("untitled:Draft", 2, 2)
  }
  scenario "a value incompatible with its declared field type is located" {
    given semanticAnalysis()
    when openSemanticSource({ uri: "untitled:Draft", text: "type Book { copies: Number = \"many\" }" }, 1)
    then expectSemanticProblem("untitled:Draft", "incompatible-type", 1, 30, 36)
    then expectNoSyntaxProblems("untitled:Draft", 1)
  }
  scenario "a supplied import permits checking the open entry" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    then expectCheckedSource(basket.uri)
  }
  scenario "changing an imported declaration updates an unchanged open entry" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when saveSemanticSource(renamedBook)
    then expectSemanticProblem(basket.uri, "unresolved-reference", 1, 5, 9)
    then expectSemanticPublications(basket.uri, 2, 1)
  }
  scenario "restoring an imported declaration clears the dependent problem" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when saveSemanticSource(renamedBook)
    when saveSemanticSource(book)
    then expectCheckedSource(basket.uri)
    then expectSemanticPublications(basket.uri, 3, 1)
  }
  scenario "a missing import remains explicit" {
    given semanticAnalysis()
    when openSemanticSource(basket, 1)
    then expectSemanticProblem(basket.uri, "unavailable-module", 1, 5, 9)
  }
  scenario "creating a missing import checks the unchanged entry" {
    given semanticAnalysis()
    when openSemanticSource(basket, 1)
    when saveSemanticSource(book)
    then expectCheckedSource(basket.uri)
    then expectSemanticPublications(basket.uri, 2, 1)
  }
  scenario "deleting an imported source invalidates the open entry" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when removeSemanticSource(book.uri)
    then expectSemanticProblem(basket.uri, "unavailable-module", 1, 5, 9)
  }
  scenario "unsaved imported text overrides saved changes" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when openSemanticSource(renamedBook, 1)
    when saveSemanticSource(book)
    then expectSemanticProblem(basket.uri, "unresolved-reference", 1, 5, 9)
    then expectSemanticPublications(basket.uri, 2, 1)
  }
  scenario "closing an imported document restores its current saved text" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when openSemanticSource(renamedBook, 1)
    when closeSemanticSource(book.uri)
    then expectCheckedSource(basket.uri)
  }
  scenario "invalid imported text never reuses an older accepted model" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when saveSemanticSource({ uri: book.uri, text: "type Book {" })
    then expectSemanticProblem(basket.uri, "unavailable-module", 1, 5, 9)
  }
  scenario "unrelated saved files do not republish an open entry" {
    given semanticAnalysis()
    when saveSemanticSource(book)
    when openSemanticSource(basket, 1)
    when saveSemanticSource({ uri: "file:///workspace/other.expec", text: "type Other { value: Text }" })
    then expectCheckedSource(basket.uri)
    then expectSemanticPublications(basket.uri, 1, 1)
  }
  scenario "an unavailable runtime package remains an explicit located problem" {
    given semanticAnalysis()
    when openSemanticSource({ uri: "untitled:Draft", text: "component Store { requires package \"storage\" for runtime }" }, 1)
    then expectSemanticProblem("untitled:Draft", "unavailable-package", 1, 36, 45)
  }
  scenario "a supplied saved runtime alias permits authored checking without proving installation" {
    given semanticAnalysis()
    when changeSemanticConfiguration(runtimePackages)
    when openSemanticSource(packageView, 1)
    when changeSemanticSource({ uri: packageView.uri, text: "component ReactScreen { requires package \"react\" for runtime }" }, 2)
    then expectCheckedSource(packageView.uri)
    then expectSemanticPublications(packageView.uri, 2, 2)
  }
  scenario "a configured test alias does not satisfy a runtime requirement" {
    given semanticAnalysis()
    when changeSemanticConfiguration(testPackages)
    when openSemanticSource(packageView, 1)
    then expectSemanticProblem(packageView.uri, "unavailable-package", 1, 40, 47)
  }
  scenario "saving supplied package facts rechecks an open document without editing its version" {
    given semanticAnalysis()
    when openSemanticSource(packageView, 3)
    when changeSemanticConfiguration(runtimePackages)
    then expectEarlierPackageProblem(packageView.uri, 1)
    then expectCheckedSource(packageView.uri)
    then expectSemanticPublications(packageView.uri, 2, 3)
  }
  scenario "switched invalid and absent saved configurations cannot reuse the previous package catalog" {
    given semanticAnalysis()
    when changeSemanticConfiguration(runtimePackages)
    when openSemanticSource(packageView, 5)
    when changeSemanticConfiguration({ file: "C:/workspace/another.json", text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/view.expec\"]},\"outputs\":[]}", writable: true })
    when changeSemanticConfiguration(runtimePackages)
    when changeSemanticConfiguration({ file: runtimePackages.file, text: "{", writable: true })
    when changeSemanticConfiguration(runtimePackages)
    when clearSemanticConfiguration()
    then expectEarlierCheckedPackageSource(packageView.uri, 1)
    then expectEarlierPackageProblem(packageView.uri, 2)
    then expectEarlierCheckedPackageSource(packageView.uri, 3)
    then expectEarlierPackageProblem(packageView.uri, 4)
    then expectEarlierCheckedPackageSource(packageView.uri, 5)
    then expectEarlierPackageProblem(packageView.uri, 6)
    then expectSemanticProblem(packageView.uri, "unavailable-package", 1, 40, 47)
    then expectSemanticPublications(packageView.uri, 6, 5)
  }

  // These are real DocumentAnalysis reports and requirementsFor results. The
  // recording source provider supplies independently authored ownership facts;
  // it never classifies scope results or derives expectations from the manifest.
  fixture scopedView: SourceDocument = {
    uri: "file:///workspace/src/ui/view.expec",
    text: "component ReactView { requires package \"react\" for runtime }"
  }
  fixture scopedTools: ConnectionConfiguration = {
    file: "C:/workspace/expec.json",
    text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/ui/view.expec\"]},\"outputs\":[],\"packages\":[{\"alias\":\"typescript\",\"name\":\"npm:typescript\",\"version\":\"5.9.3\",\"phases\":[\"build\"]},{\"alias\":\"vitest\",\"name\":\"npm:vitest\",\"version\":\"5.0.2\",\"phases\":[\"test\"]},{\"alias\":\"react\",\"name\":\"npm:react\",\"version\":\"19.3.0\",\"phases\":[\"runtime\"]},{\"alias\":\"playwright\",\"name\":\"npm:playwright\",\"version\":\"1.63.0\",\"phases\":[\"test\"]}],\"requirements\":{\"project\":{\"build\":[\"typescript\"],\"test\":[\"vitest\"]},\"folders\":[{\"path\":\"src/ui\",\"runtime\":[\"react\"]}],\"files\":[{\"path\":\"src/ui/view.expec\",\"test\":[\"playwright\"]}]}}",
    writable: true
  }

  fixture movedFolderTools: ConnectionConfiguration = {
    file: "C:/workspace/expec.json",
    text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/ui/view.expec\"]},\"outputs\":[],\"packages\":[{\"alias\":\"typescript\",\"name\":\"npm:typescript\",\"version\":\"5.9.3\",\"phases\":[\"build\"]},{\"alias\":\"vitest\",\"name\":\"npm:vitest\",\"version\":\"5.0.2\",\"phases\":[\"test\"]},{\"alias\":\"react\",\"name\":\"npm:react\",\"version\":\"19.3.0\",\"phases\":[\"runtime\"]},{\"alias\":\"playwright\",\"name\":\"npm:playwright\",\"version\":\"1.63.0\",\"phases\":[\"test\"]}],\"requirements\":{\"project\":{\"build\":[\"typescript\"],\"test\":[\"vitest\"]},\"folders\":[{\"path\":\"src/core\",\"runtime\":[\"react\"]}],\"files\":[{\"path\":\"src/ui/view.expec\",\"test\":[\"playwright\"]}]}}",
    writable: true
  }

  fixture unknownScopedAlias: ConnectionConfiguration = {
    file: "C:/workspace/expec.json",
    text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/ui/view.expec\"]},\"outputs\":[],\"packages\":[{\"alias\":\"typescript\",\"name\":\"npm:typescript\",\"version\":\"5.9.3\",\"phases\":[\"build\"]},{\"alias\":\"vitest\",\"name\":\"npm:vitest\",\"version\":\"5.0.2\",\"phases\":[\"test\"]},{\"alias\":\"react\",\"name\":\"npm:react\",\"version\":\"19.3.0\",\"phases\":[\"runtime\"]},{\"alias\":\"playwright\",\"name\":\"npm:playwright\",\"version\":\"1.63.0\",\"phases\":[\"test\"]}],\"requirements\":{\"project\":{\"build\":[\"typescript\"],\"test\":[\"vitest\"]},\"folders\":[{\"path\":\"src/ui\",\"runtime\":[\"react\"]}],\"files\":[{\"path\":\"unreached/view.expec\",\"test\":[\"storage\"]}]}}",
    writable: true
  }

  fixture wrongScopedPhase: ConnectionConfiguration = {
    file: "C:/workspace/expec.json",
    text: "{\"formatVersion\":1,\"version\":\"0.1.0\",\"build\":{\"entries\":[\"src/ui/view.expec\"]},\"outputs\":[],\"packages\":[{\"alias\":\"typescript\",\"name\":\"npm:typescript\",\"version\":\"5.9.3\",\"phases\":[\"build\"]},{\"alias\":\"vitest\",\"name\":\"npm:vitest\",\"version\":\"5.0.2\",\"phases\":[\"test\"]},{\"alias\":\"react\",\"name\":\"npm:react\",\"version\":\"19.3.0\",\"phases\":[\"runtime\"]},{\"alias\":\"playwright\",\"name\":\"npm:playwright\",\"version\":\"1.63.0\",\"phases\":[\"test\"]}],\"requirements\":{\"project\":{\"build\":[\"typescript\"],\"test\":[\"vitest\"]},\"folders\":[{\"path\":\"src/ui\",\"runtime\":[\"react\"]}],\"files\":[{\"path\":\"unreached/view.expec\",\"test\":[\"react\"]}]}}",
    writable: true
  }

  action semanticSourcePath(uri: Text, path: Text) returns Nothing
  action tryMutatingSemanticRequirements(uri: Text, publication: Number) returns Nothing
  observation semanticRequirementAliases(uri: Text, publication: Number, phase: Text) returns List<Text>
  observation semanticDependencyProblemCode(uri: Text, publication: Number) returns Text
  observation semanticDependencyProblemPath(uri: Text, publication: Number) returns Text
  observation semanticDependencyProblemCount(uri: Text, publication: Number) returns Number
  // The comparison owns a tiny actual manifest/source, uses SourceLoader and the
  // native FileSources ownership query, then feeds that same unsaved source to
  // live analysis. It compares actual rows/origins and does not install anything.
  setup scopedSourceComparison(configuration: ConnectionConfiguration, sourcePath: Text, text: Text) returns Nothing
  action compareCapturedAndLiveScopes() returns Nothing
  observation capturedAndLiveRequirementsAgree() returns Boolean
  observation capturedScopeAliases(phase: Text) returns List<Text>
  observation liveScopeAliases(phase: Text) returns List<Text>
  observation scopedComparisonFilesUnchanged() returns Boolean

  check expectScopedRequirements(uri: Text, publication: Number, phase: Text, aliases: List<Text>) {
    let actual = semanticRequirementAliases(uri, publication, phase)
    assert actual == aliases
  }
  check expectScopeProblem(uri: Text, publication: Number, code: Text, path: Text) {
    let actualCode = semanticDependencyProblemCode(uri, publication)
    let actualPath = semanticDependencyProblemPath(uri, publication)
    let count = semanticDependencyProblemCount(uri, publication)
    assert actualCode == code
    assert actualPath == path
    assert count == 1
  }
  check expectNoScopeProblems(uri: Text, publication: Number) {
    let count = semanticDependencyProblemCount(uri, publication)
    assert count == 0
  }
  check expectCapturedAndLiveScopes() {
    let same = capturedAndLiveRequirementsAgree()
    let capturedBuild = capturedScopeAliases("build")
    let liveBuild = liveScopeAliases("build")
    let capturedRuntime = capturedScopeAliases("runtime")
    let liveRuntime = liveScopeAliases("runtime")
    let capturedTest = capturedScopeAliases("test")
    let liveTest = liveScopeAliases("test")
    let unchanged = scopedComparisonFilesUnchanged()
    assert same == true
    assert capturedBuild == ["typescript"]
    assert liveBuild == ["typescript"]
    assert capturedRuntime == ["react"]
    assert liveRuntime == ["react"]
    assert capturedTest == ["vitest", "playwright"]
    assert liveTest == ["vitest", "playwright"]
    assert unchanged == true
  }

  scenario "a current UI source inherits shared tools folder runtime and its exact file test driver" {
    given semanticAnalysis()
    when semanticSourcePath(scopedView.uri, "src/ui/view.expec")
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource(scopedView, 4)
    then expectScopedRequirements(scopedView.uri, 1, "build", ["typescript"])
    then expectScopedRequirements(scopedView.uri, 1, "runtime", ["react"])
    then expectScopedRequirements(scopedView.uri, 1, "test", ["vitest", "playwright"])
    then expectNoScopeProblems(scopedView.uri, 1)
    then expectCheckedSource(scopedView.uri)
  }
  scenario "a sibling folder does not inherit a prefix-matching UI scope or another file's driver" {
    given semanticAnalysis()
    when semanticSourcePath("file:///workspace/src/ui-other/view.expec", "src/ui-other/view.expec")
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource({ uri: "file:///workspace/src/ui-other/view.expec", text: "type Book { title: Text }" }, 1)
    then expectScopedRequirements("file:///workspace/src/ui-other/view.expec", 1, "build", ["typescript"])
    then expectScopedRequirements("file:///workspace/src/ui-other/view.expec", 1, "runtime", [])
    then expectScopedRequirements("file:///workspace/src/ui-other/view.expec", 1, "test", ["vitest"])
    then expectCheckedSource("file:///workspace/src/ui-other/view.expec")
  }
  scenario "foreign and untitled snapshots use shared tools without invented folder ownership" {
    given semanticAnalysis()
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource({ uri: "file:///elsewhere/src/ui/view.expec", text: "type Book {}" }, 1)
    when openSemanticSource({ uri: "untitled:Draft", text: "type Draft {}" }, 1)
    then expectScopedRequirements("file:///elsewhere/src/ui/view.expec", 1, "build", ["typescript"])
    then expectScopedRequirements("file:///elsewhere/src/ui/view.expec", 1, "runtime", [])
    then expectScopedRequirements("untitled:Draft", 1, "build", ["typescript"])
    then expectScopedRequirements("untitled:Draft", 1, "runtime", [])
    then expectCheckedSource("file:///elsewhere/src/ui/view.expec")
    then expectCheckedSource("untitled:Draft")
  }
  scenario "saved scope replacement rechecks unchanged unsaved text and preserves earlier rows" {
    given semanticAnalysis()
    when semanticSourcePath(scopedView.uri, "src/ui/view.expec")
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource(scopedView, 7)
    when changeSemanticConfiguration(movedFolderTools)
    when tryMutatingSemanticRequirements(scopedView.uri, 1)
    then expectScopedRequirements(scopedView.uri, 1, "runtime", ["react"])
    then expectScopedRequirements(scopedView.uri, 2, "runtime", [])
    then expectScopedRequirements(scopedView.uri, 2, "test", ["vitest", "playwright"])
    then expectSemanticPublications(scopedView.uri, 2, 7)
    then expectCheckedSource(scopedView.uri)
  }
  scenario "an invalid declared alias withdraws old scope rows and catalog with its actual manifest origin" {
    given semanticAnalysis()
    when semanticSourcePath(scopedView.uri, "src/ui/view.expec")
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource(scopedView, 5)
    when changeSemanticConfiguration(unknownScopedAlias)
    then expectScopedRequirements(scopedView.uri, 1, "runtime", ["react"])
    then expectScopedRequirements(scopedView.uri, 2, "runtime", [])
    then expectScopeProblem(scopedView.uri, 2, "unknown-package-alias", "[\"manifest\",\"C:/workspace/expec.json\",\"requirements\",\"files\",0,\"test\",0]")
    then expectSemanticProblem(scopedView.uri, "unavailable-package", 1, 40, 47)
    then expectSemanticPublications(scopedView.uri, 2, 5)
  }
  scenario "a wrong phase in an unreached file scope is still an honest located configuration failure" {
    given semanticAnalysis()
    when changeSemanticConfiguration(wrongScopedPhase)
    when openSemanticSource({ uri: "untitled:Draft", text: "type Draft {}" }, 2)
    then expectScopeProblem("untitled:Draft", 1, "unavailable-package", "[\"manifest\",\"C:/workspace/expec.json\",\"requirements\",\"files\",0,\"test\",0]")
    then expectScopedRequirements("untitled:Draft", 1, "build", [])
  }
  scenario "a malformed supplied ownership path refuses scope facts without changing actual compilation" {
    given semanticAnalysis()
    when semanticSourcePath(scopedView.uri, "src/ui/../view.expec")
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource(scopedView, 3)
    then expectScopeProblem(scopedView.uri, 1, "invalid-dependency-input", "[\"sources\",0,\"localPath\"]")
    then expectScopedRequirements(scopedView.uri, 1, "runtime", [])
    then expectCheckedSource(scopedView.uri)
  }
  scenario "a named unsaved source uses supplied verified ancestry without needing saved source contents" {
    given semanticAnalysis()
    when semanticSourcePath("file:///workspace/src/ui/new.expec", "src/ui/new.expec")
    when changeSemanticConfiguration(scopedTools)
    when openSemanticSource({ uri: "file:///workspace/src/ui/new.expec", text: "component NewView { requires package \"react\" for runtime }" }, 1)
    then expectScopedRequirements("file:///workspace/src/ui/new.expec", 1, "runtime", ["react"])
    then expectScopedRequirements("file:///workspace/src/ui/new.expec", 1, "test", ["vitest"])
    then expectCheckedSource("file:///workspace/src/ui/new.expec")
  }
  scenario "live checking and the real source loader prepare the same owned scope obligations" {
    given scopedSourceComparison(scopedTools, "src/ui/view.expec", "component ReactView { requires package \"react\" for runtime }")
    when compareCapturedAndLiveScopes()
    then expectCapturedAndLiveScopes()
  }

}

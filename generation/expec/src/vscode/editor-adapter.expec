use WorkspaceCore, SourceDocument, OutputTab from "../core/workspace.expec"

component EditorAdapter {
  requires package "typescript" for build
  requires package "vite" for build
  requires package "vitest" for test

  construction(core: WorkspaceCore)
  public documentChanged, documentSaved

  capability documentChanged(source: SourceDocument) returns List<OutputTab> {
    promises "Translate an editor document change into core.preview with the exact URI and current text. Return core's tabs unchanged, without sending a save request."
  }

  capability documentSaved(source: SourceDocument) returns Nothing {
    promises "Translate an editor save into core.sourceSaved with the exact URI and saved text. Core owns the generation policy."
  }
}

// Routing examples use the real adapter with a recording core boundary.
// They do not stand in for a VS Code host, language server or output implementation.
examples for EditorAdapter {
  fixture editedDocument: SourceDocument = {
    uri: "file:///workspace/src/library.expec",
    text: "type Book {\n  title: Text\n  copies: Number\n}"
  }
  fixture previewTabs: List<OutputTab> = [
    { id: "markdown", label: "Markdown", content: "# Edited Book" }
  ]

  setup editorCoreReturns(tabs: List<OutputTab>) returns Nothing
  action changeEditorDocument(source: SourceDocument) returns Nothing
  action saveEditorDocument(source: SourceDocument) returns Nothing
  observation corePreviewRequests() returns List<SourceDocument>
  observation coreSaveRequests() returns List<SourceDocument>
  observation editorPreviewTabs() returns List<OutputTab>

  check expectCoreRequests(previews: List<SourceDocument>, saves: List<SourceDocument>) {
    let actualPreviews = corePreviewRequests()
    let actualSaves = coreSaveRequests()
    assert actualPreviews == previews
    assert actualSaves == saves
  }
  check expectEditorPreviews(expected: List<OutputTab>) {
    let actual = editorPreviewTabs()
    assert actual == expected
  }

  scenario "preview the current unsaved editor text" {
    given editorCoreReturns(previewTabs)
    when changeEditorDocument(editedDocument)
    then expectCoreRequests([editedDocument], [])
    then expectEditorPreviews(previewTabs)
  }

  scenario "forward a saved document to core's save policy" {
    given editorCoreReturns(previewTabs)
    when saveEditorDocument(editedDocument)
    then expectCoreRequests([], [editedDocument])
  }
}

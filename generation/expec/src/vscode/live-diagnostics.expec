use OutputPreviews from "../core/output-previews.expec"
use DocumentAnalysis, DocumentReport, DocumentSources from "../core/document-analysis.expec"
use SourceDocument from "../core/workspace.expec"
use SourceNavigation from "../core/source-navigation.expec"
use SourceDefinitionAdapter from "./source-navigation.expec"
use SourceHover from "../core/source-hover.expec"
use SourceHoverAdapter from "./source-hover.expec"
use DocumentOutline from "../core/document-outline.expec"
use SourceOutlineAdapter from "./document-outline.expec"
use SourceCompletion from "../core/source-completion.expec"
use SourceCompletionAdapter from "./source-completion.expec"

// Native types are confined to the VS Code/LSP boundary.
opaque type LanguageServerConnection
opaque type VsCodeExtensionContext
opaque type NativeLanguageClient

component LanguageServerAdapter {
  requires package "language-server" for runtime
  requires package "language-server-document" for runtime
  requires package "expec" for runtime
  requires package "typescript" for build
  depends on DocumentAnalysis
  depends on OutputPreviews
  depends on SourceNavigation
  depends on SourceDefinitionAdapter
  depends on SourceHover
  depends on SourceHoverAdapter
  depends on DocumentOutline
  depends on SourceOutlineAdapter
  depends on SourceCompletion
  depends on SourceCompletionAdapter

  construction(connection: LanguageServerConnection, sources: DocumentSources)
  public start, publish, clear, dispose

  capability start() returns Nothing {
    promises "Register native LSP initialization and document events once, using TextDocuments to reconstruct incremental text. Feed actual open/change/close snapshots and versions to core DocumentAnalysis. Opening must check exactly once despite TextDocuments also emitting a content-change event. Core owns checking and version/lifetime policy; this adapter owns protocol registration and translation. Register standard LSP document diagnostic pull with inter-file dependencies and no workspace diagnostic enumeration, and negotiate UTF-16 positions. Register standard LSP watched-file notifications for requested dependency URIs, including currently missing files, using native relative-pattern registration. Core chooses relevant invalidation; forward creation/change/deletion to sourceChanged. Reconcile capture-to-watch gaps by rechecking after each newly established registration. Retain registrations only for dependency URIs requested by current open entries, and dispose them when unneeded or on shutdown. Unsupported native watch capabilities remain an observable limitation rather than a promised live update. Do not scan or compile in the adapter. Register native preview selection/configuration notifications and forward them to one core OutputPreviews instance using its default shipped registrations. Its feedback emits only plain PreviewPublication values through the native channel. Do not construct another reader/compiler or inspect output models. Advertise definitionProvider and register standard textDocument/definition once. Obtain the current TextDocuments snapshot, then delegate coordinate conversion and the query to SourceDefinitionAdapter with one core SourceNavigation. Missing/cancelled/currently unavailable documents return no location. The adapter never chooses targets or rechecks source. Advertise hoverProvider and register standard textDocument/hover once. Obtain the current TextDocuments snapshot and delegate to SourceHoverAdapter using one core SourceHover; missing, cancelled or unavailable snapshots return absence. Hover uses the same existing analysis publications as diagnostics and navigation, without another reader/compiler."
    promises "Advertise documentSymbolProvider and register standard textDocument/documentSymbol once. Use the existing current TextDocuments snapshot and delegate to one SourceOutlineAdapter with one core DocumentOutline. Missing, cancelled, disposed or currently unavailable documents have no outline. Preserve one shared DocumentAnalysis and its current source/version/lifetime; no extra analysis, declaration walk or project connection is created for this request."
    promises "Advertise completionProvider without trigger characters or resolve support and register standard textDocument/completion once. Use the actual current TextDocuments entry and delegate to one SourceCompletionAdapter with one core SourceCompletion. Cancelled, missing or disposed requests return an empty list. Reuse the same existing DocumentAnalysis publication; do not parse, resolve, acquire, generate or construct a second analysis for completion."
  }
  capability publish(source: SourceDocument, version: Number, report: DocumentReport) returns Nothing {
    promises "Retain real syntax and compiler errors whose primary source URI matches this document in its current native pull cache. Foreign primary findings remain in the raw Compilation and output log; an open imported document receives its own entry analysis. Never attach a foreign primary range to the requesting document. Convert each scalar range with the captured text for that range's exact URI, including cross-file related information. Preserve messages and codes. Keep nonlocated problems and deferred requirements observable in the language-client output log without inventing editor positions. Replace old feedback, including an empty full report when findings clear. Give each accepted publication an opaque analysis resultId; editor version alone cannot identify changed imports. Request the SDK diagnostic refresh after dependent feedback changes. Never reparse, generate or make semantic decisions here. Forward this same captured source/version/report to core OutputPreviews before reducing it to native diagnostic data; preserve ordinary diagnostic publication and dependency-watch behavior. Forward this same current source/version/report to one core SourceNavigation before native conversion. Forward this same current source/version/report to one core SourceHover before native conversion, including same-version replacement reports after imported edits. No Inspection or Specification crosses the protocol boundary."
    promises "Forward the same current captured source/version/report to DocumentOutline before answering native symbol requests. A replacement or rejected report replaces its earlier tree even at the same editor version; transport only plain native symbols, never Inspection or a compiler model."
    promises "Forward this same current captured source/version/report to SourceCompletion before native conversion, including same-version replacement after imported edits and rejected reports that withdraw old completion facts. Transport only plain native CompletionItems; Inspection and Resolution stay within core."
  }
  capability clear(uri: Text) returns Nothing {
    promises "Remove the closed document from the pull-response cache. Native document diagnostic pull owns editor close cleanup; never resurrect a cached response from an earlier lifetime. Forward this closed URI to core OutputPreviews so pending work and selected content from the closed lifetime are withdrawn. End the same core SourceNavigation and SourceHover report lifetimes through closed(uri)."
    promises "End this same DocumentOutline lifetime through closed(uri); later requests cannot use the closed document's tree."
    promises "End this same SourceCompletion lifetime through closed(uri); later completion requests cannot use its earlier facts."
  }
  capability dispose() returns Nothing {
    promises "Remove owned subscriptions, end tracked document lifetimes and prevent further diagnostic publication. Repeated disposal is harmless. Leave connection/process shutdown to the native server entry point. Dispose core OutputPreviews, invalidating pending output work; started renderer callbacks retain their own asynchronous cleanup obligation. Dispose SourceNavigation and its retained reports; later definition requests cannot use old targets. Dispose SourceHover; later hover requests cannot retain earlier meaning."
    promises "Release the owned document-symbol registration once and dispose DocumentOutline. Later callbacks cannot publish or return a retained tree."
    promises "Release the owned completion registration once and dispose SourceCompletion. Later callbacks cannot publish or return retained suggestions."
  }
}

component FileSources {
  requires package "node-types" for build
  requires package "typescript" for build
  public read
  capability read(uri: Text) returns SourceDocument? {
    promises "Adapt a local file URI to its current UTF-8 saved text for DocumentSources. Missing files and unsupported URI schemes return absence. Other filesystem errors surface. Do not scan folders, acquire packages, cache business state or replace open editor text."
  }
}

component EditorLanguageSupport {
  requires package "language-client" for runtime
  requires package "vscode-types" for build
  requires package "typescript" for build
  requires package "vite" for build
  requires package "vitest" for test
  requires package "vscode-test-electron" for test
  depends on LanguageServerAdapter

  construction(context: VsCodeExtensionContext, client: NativeLanguageClient)
  public start, dispose

  capability start() returns Nothing {
    promises "Request startup of the supplied native LanguageClient once. The native entry point owns its construction, packaged TypeScript server, expec selector (file and untitled), and single awaited stop on deactivation. Return that native client through the standard VS Code activation export for callers of its native feature APIs. Register owned resources with this extension context. Use native document diagnostic pull on edits. In the public provideDiagnostics middleware capture native document identity/version before awaiting next, then cancel an obsolete/closed result instead of returning empty success. The SDK owns scheduling, cancellation and diagnostic collections. Never replace newer feedback or reopen diagnostics for a closed document; do not rely on push version fields. Guard public provideDefinition middleware with the requesting native document identity/version around its await, preserving prior middleware. Cancel obsolete, closed, disposed or cancelled requests rather than returning an old target. For returned target URIs already open when the request began, also refuse a result if that captured target buffer changed or ended its lifetime while awaiting. Core reports establish point-in-time meaning; this does not promise editor/filesystem atomicity across the process boundary. Guard public provideHover middleware with requesting native document identity/version around its await, preserving prior middleware. Capture the requesting document and currently open expec buffer identities/versions before awaiting. After the prior middleware or next resolves, cancel if disposed, token-cancelled, or any captured buffer changed, closed or was replaced, since a hover reply does not identify its declaration source across the native boundary. Restore only this adapter's own middleware on disposal. This conservative pending-request guard does not claim filesystem/editor atomicity or replace core resolution policy. Keep startup failures observable and keep core policy out of this host adapter."
    promises "Guard standard provideDocumentSymbols middleware with the requesting native document identity/version around awaiting next. Preserve prior middleware and restore only the wrapper this adapter owns. Cancel an obsolete, closed, disposed or cancelled response rather than returning an old outline or invented empty success. Other unchanged documents remain usable. The native SDK owns the outline UI and scheduling; this adapter owns only native request currentness."
    promises "Guard the public provideCompletionItem middleware around awaiting the prior middleware or real continuation, preserving its exact replies. Capture the requesting document identity/version and currently open expec buffer identities/versions. Cancel a pending reply after requester or captured import-buffer change, close or replacement, token cancellation or disposal. Other-language buffer changes do not cancel completion. Release only this adapter's own wrapper. This protects a pending response; it does not promise editor/filesystem atomicity or safety when a user later chooses an already returned item. Core owns candidate policy and prepared facts."
  }
  capability dispose() returns Nothing {
    promises "Invalidate adapter-owned callbacks and remove owned registrations once. The native entry point owns the injected client and awaits its one stop promise on deactivation; this operation neither stops that client twice nor promises synchronous process termination."
  }
}

// Real installed VSIX and language server. The driver edits actual native documents,
// observes native diagnostics/events, and closes owned documents/listeners per case.
// Keep one reusable host; use a fresh test-owned workspace and document URI per case.
// Each edit waits, within a deadline, for actual native pull completion/application for
// that captured document identity/version and opaque report identity, through the exported native client feature API
// and real editor diagnostic events. A changed editor.version or an already empty
// collection is not completion evidence. editQuickly submits both edits before waiting.
// Closing starts from established feedback and observes actual editor tab closure plus
// native diagnostic collection cleanup. Discard unsaved edits through the standard editor
// command. Do not manually clear diagnostics, send a fake protocol close, or delete the
// file to force closure. VS Code may retain a saved-file TextDocument in its buffer cache
// after the editor tab closes; buffer eviction/isClosed/LSP DidClose is not this UI boundary.
// Actual LSP close events still end the core lifetime when native buffer disposal occurs.
// Each case closes its owned tab and removes its listeners/files; native buffer cache
// ownership belongs to VS Code and ends with the shared host, rather than a test invention.
// The untitled setup supplies initial text, not a saved disk file.
// These are proposed acceptance steps, not existing executable results.
examples for EditorLanguageSupport {
  setup diagnosticEditor(fileName: Text, initialText: Text) returns Nothing
  action editWithoutSaving(text: Text) returns Nothing
  action editQuickly(first: Text, latest: Text) returns Nothing
  action closeEditedDocument() returns Nothing
  observation previouslyVisibleProblemCount() returns Number
  observation editorProblemCount() returns Number
  observation editorProblemMessage() returns Text
  observation editorProblemIsError() returns Boolean
  observation editorProblemStartLine() returns Number
  observation editorProblemStartColumn() returns Number
  observation editorProblemEndLine() returns Number
  observation editorProblemEndColumn() returns Number
  observation savedDocumentText() returns Text
  observation openDocumentText() returns Text
  observation openDocumentIsDirty() returns Boolean

  // Display lines/columns are one-based UTF-16, as shown by the editor.
  check expectEditorSyntaxProblem(line: Number, column: Number, endLine: Number, endColumn: Number) {
    let count = editorProblemCount()
    let explanation = editorProblemMessage()
    let isError = editorProblemIsError()
    let actualLine = editorProblemStartLine()
    let actualColumn = editorProblemStartColumn()
    let actualEndLine = editorProblemEndLine()
    let actualEndColumn = editorProblemEndColumn()
    assert count == 1
    assert explanation != ""
    assert isError == true
    assert actualLine == line
    assert actualColumn == column
    assert actualEndLine == endLine
    assert actualEndColumn == endColumn
  }
  check expectResolvedEditorProblem() {
    let previous = previouslyVisibleProblemCount()
    assert previous == 1
    let actual = editorProblemCount()
    assert actual == 0
  }
  check expectUnsavedText(current: Text, saved: Text) {
    let actualCurrent = openDocumentText()
    let actualSaved = savedDocumentText()
    let dirty = openDocumentIsDirty()
    assert actualCurrent == current
    assert actualSaved == saved
    assert dirty == true
  }

  scenario "show a missing brace from unsaved text without changing the saved file" {
    given diagnosticEditor("library.expec", "type Book {\n  title: Text\n}")
    when editWithoutSaving("type Book {\n  title: Text\n")
    then expectEditorSyntaxProblem(3, 1, 3, 1)
    then expectUnsavedText("type Book {\n  title: Text\n", "type Book {\n  title: Text\n}")
  }
  scenario "fixing an unsaved syntax error clears its diagnostic" {
    given diagnosticEditor("library.expec", "type Book {\n  title: Text\n}")
    when editWithoutSaving("type Book {\n  title: Text\n")
    when editWithoutSaving("type Book {\n  title: Text\n  copies: Number\n}")
    then expectResolvedEditorProblem()
    then expectUnsavedText("type Book {\n  title: Text\n  copies: Number\n}", "type Book {\n  title: Text\n}")
  }
  scenario "rapid edits keep diagnostics for the latest text" {
    given diagnosticEditor("library.expec", "type Book { title: Text }")
    when editWithoutSaving("type Book {")
    when editQuickly("type Book { title: @ }", "type Book { title: Text\n  copies: Number }")
    then expectResolvedEditorProblem()
    then expectUnsavedText("type Book { title: Text\n  copies: Number }", "type Book { title: Text }")
  }
  scenario "locate errors after an astral character using editor columns" {
    given diagnosticEditor("unicode.expec", "type `📚` { title: Text }")
    when editWithoutSaving("type `📚` { title: Text @ }")
    then expectEditorSyntaxProblem(1, 25, 1, 26)
  }
  scenario "closing a document clears its owned diagnostics" {
    given diagnosticEditor("library.expec", "type Book { title: Text }")
    when editWithoutSaving("type Book {")
    when closeEditedDocument()
    then expectResolvedEditorProblem()
  }
  scenario "untitled expec documents receive syntax feedback without a project connection" {
    given diagnosticEditor("untitled:Draft.expec", "type Draft { title: Text }")
    when editWithoutSaving("type Draft {")
    then expectEditorSyntaxProblem(1, 13, 1, 13)
  }
  // Saved-import actions mutate only the test-owned dependency file. Completion is
  // actual native watched-file delivery plus changed opaque pull resultId and editor
  // diagnostic application; an unchanged editor version/empty list is not evidence.
  setup importedEditor(entryText: Text, dependencyText: Text) returns Nothing
  // Missing setup awaits actual unavailable-module feedback before the action.
  setup missingImportedEditor(entryText: Text) returns Nothing
  action saveImportedText(text: Text) returns Nothing
  action deleteImportedFile() returns Nothing
  observation editorProblemCode() returns Text
  observation entryVersionUnchanged() returns Boolean

  check expectEditorSemanticCode(code: Text) {
    let actualCode = editorProblemCode()
    assert actualCode == code
  }
  check expectUnchangedEntryVersion() {
    let unchanged = entryVersionUnchanged()
    assert unchanged == true
  }

  scenario "an unsaved unknown type is reported" {
    given diagnosticEditor("basket.expec", "type Basket { book: Text }")
    when editWithoutSaving("type Basket { book: Boook }")
    then expectEditorSemanticCode("unresolved-reference")
    then expectEditorSyntaxProblem(1, 21, 1, 26)
    then expectUnsavedText("type Basket { book: Boook }", "type Basket { book: Text }")
  }
  scenario "fixing an unsaved unknown type clears feedback" {
    given diagnosticEditor("basket.expec", "type Basket { book: Text }")
    when editWithoutSaving("type Basket { book: Boook }")
    when editWithoutSaving("type Basket { book: Number }")
    then expectResolvedEditorProblem()
    then expectUnsavedText("type Basket { book: Number }", "type Basket { book: Text }")
  }
  scenario "saved imported changes refresh diagnostics without editing the entry" {
    given importedEditor("use Book from \"./book.expec\"\ntype Basket { book: Book }", "type Book { title: Text }")
    when saveImportedText("type Magazine { title: Text }")
    then expectEditorSemanticCode("unresolved-reference")
    then expectEditorSyntaxProblem(1, 5, 1, 9)
    then expectUnchangedEntryVersion()
  }
  scenario "restoring an imported declaration clears the dependent editor problem" {
    given importedEditor("use Book from \"./book.expec\"\ntype Basket { book: Book }", "type Book { title: Text }")
    when saveImportedText("type Magazine { title: Text }")
    when saveImportedText("type Book { title: Text }")
    then expectResolvedEditorProblem()
    then expectUnchangedEntryVersion()
  }
  scenario "deleting an imported file reports the missing module" {
    given importedEditor("use Book from \"./book.expec\"\ntype Basket { book: Book }", "type Book { title: Text }")
    when deleteImportedFile()
    then expectEditorSemanticCode("unavailable-module")
    then expectEditorSyntaxProblem(1, 5, 1, 9)
    then expectUnchangedEntryVersion()
  }
  scenario "recreating an imported file clears its dependent editor problem" {
    given importedEditor("use Book from \"./book.expec\"\ntype Basket { book: Book }", "type Book { title: Text }")
    when deleteImportedFile()
    when saveImportedText("type Book { title: Text }")
    then expectResolvedEditorProblem()
    then expectUnchangedEntryVersion()
  }
  scenario "creating an initially missing import establishes live dependency feedback" {
    given missingImportedEditor("use Book from \"./book.expec\"\ntype Basket { book: Book }")
    when saveImportedText("type Magazine { title: Text }")
    then expectEditorSemanticCode("unresolved-reference")
    then expectEditorSyntaxProblem(1, 5, 1, 9)
    then expectUnchangedEntryVersion()
  }
  scenario "creating an initially missing import clears its editor problem" {
    given missingImportedEditor("use Book from \"./book.expec\"\ntype Basket { book: Book }")
    when saveImportedText("type Book { title: Text }")
    then expectResolvedEditorProblem()
    then expectUnchangedEntryVersion()
  }
}

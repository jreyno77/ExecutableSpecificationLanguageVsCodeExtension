{
  "formatVersion": 1,
  "version": "0.1.0",
  "project": {
    "root": "../.."
  },
  "build": {
    "entries": [
      "src/core/workspace.expec",
      "src/ui/output-tabs.expec",
      "src/vscode/editor-adapter.expec",
      "src/vscode/language-support.expec",
      "src/core/document-analysis.expec",
      "src/vscode/live-diagnostics.expec",
      "src/core/project-connection.expec",
      "src/vscode/project-connection.expec",
      "src/core/output-previews.expec",
      "src/vscode/output-previews.expec",
      "src/core/generation-on-save.expec",
      "src/vscode/generation-on-save.expec",
      "src/core/source-navigation.expec",
      "src/vscode/source-navigation.expec",
      "src/core/source-hover.expec",
      "src/vscode/source-hover.expec",
      "src/core/document-outline.expec",
      "src/vscode/document-outline.expec",
      "src/core/source-completion.expec",
      "src/vscode/source-completion.expec"
    ]
  },
  "outputs": [
    {
      "id": "typescript",
      "options": {
        "sourceRoot": ".",
        "directory": ".",
        "configFile": "tsconfig.json",
        "imports": [
          {
            "declaration": [
              "VsCodeDocument"
            ],
            "name": "TextDocument",
            "from": "vscode"
          },
          {
            "declaration": [
              "SyntaxProblem"
            ],
            "from": "executable-specification-language",
            "name": "SyntaxDiagnostic"
          },
          {
            "declaration": [
              "LanguageServerConnection"
            ],
            "from": "vscode-languageserver/node",
            "name": "Connection"
          },
          {
            "declaration": [
              "VsCodeExtensionContext"
            ],
            "from": "vscode",
            "name": "ExtensionContext"
          },
          {
            "declaration": [
              "NativeLanguageClient"
            ],
            "name": "LanguageClient",
            "from": "vscode-languageclient/node"
          },
          {
            "declaration": [
              "CompilerReport"
            ],
            "from": "executable-specification-language",
            "name": "Compilation"
          },
          {
            "declaration": [
              "RegisteredOutput"
            ],
            "from": "executable-specification-language",
            "name": "OutputRegistration"
          },
          {
            "declaration": [
              "SourceInspection"
            ],
            "from": "executable-specification-language",
            "name": "Inspection"
          },
          {
            "declaration": [
              "SourceResolution"
            ],
            "from": "executable-specification-language",
            "name": "Resolution"
          },
          {
            "declaration": [
              "DefinitionTextDocument"
            ],
            "from": "vscode-languageserver-textdocument",
            "name": "TextDocument"
          },
          {
            "declaration": [
              "DefinitionPosition"
            ],
            "from": "vscode-languageserver",
            "name": "Position"
          },
          {
            "declaration": [
              "DefinitionLocation"
            ],
            "from": "vscode-languageserver",
            "name": "Location"
          },
          {
            "declaration": [
              "NativeHover"
            ],
            "from": "vscode-languageserver",
            "name": "Hover"
          },
          {
            "declaration": [
              "OutlineTextDocument"
            ],
            "from": "vscode-languageserver-textdocument",
            "name": "TextDocument"
          },
          {
            "declaration": [
              "OutlineDocumentSymbol"
            ],
            "from": "vscode-languageserver",
            "name": "DocumentSymbol"
          },
          {
            "declaration": [
              "NativeCompletionItem"
            ],
            "from": "vscode-languageserver",
            "name": "CompletionItem"
          }
        ]
      }
    },
    {
      "id": "uml",
      "options": {
        "directory": "generation/uml",
        "views": [
          "structure"
        ]
      }
    },
    {
      "id": "acceptance",
      "options": {
        "domain": "workspace",
        "configFile": "tsconfig.json",
        "names": [
          {
            "declaration": [
              "EditorAdapter",
              "documentChanged",
              "document"
            ],
            "name": "source"
          },
          {
            "declaration": [
              "EditorAdapter",
              "documentSaved",
              "document"
            ],
            "name": "source"
          }
        ]
      }
    }
  ],
  "packages": [
    {
      "alias": "react",
      "name": "npm:react",
      "version": "19.3.0",
      "phases": [
        "runtime"
      ]
    },
    {
      "alias": "react-dom",
      "name": "npm:react-dom",
      "version": "19.3.0",
      "phases": [
        "runtime"
      ]
    },
    {
      "alias": "typescript",
      "name": "npm:typescript",
      "version": "5.9.3",
      "phases": [
        "build"
      ]
    },
    {
      "alias": "vite",
      "name": "npm:vite",
      "version": "8.3.3",
      "phases": [
        "build",
        "test"
      ]
    },
    {
      "alias": "vite-react",
      "name": "npm:@vitejs/plugin-react",
      "version": "6.1.2",
      "phases": [
        "build",
        "test"
      ]
    },
    {
      "alias": "react-types",
      "name": "npm:@types/react",
      "version": "19.3.0",
      "phases": [
        "build"
      ]
    },
    {
      "alias": "react-dom-types",
      "name": "npm:@types/react-dom",
      "version": "19.3.0",
      "phases": [
        "build"
      ]
    },
    {
      "alias": "vscode-types",
      "name": "npm:@types/vscode",
      "version": "1.100.0",
      "phases": [
        "build"
      ]
    },
    {
      "alias": "node-types",
      "name": "npm:@types/node",
      "version": "24.13.6",
      "phases": [
        "build"
      ]
    },
    {
      "alias": "vitest",
      "name": "npm:vitest",
      "version": "5.0.2",
      "phases": [
        "test"
      ]
    },
    {
      "alias": "playwright",
      "name": "npm:playwright",
      "version": "1.63.0",
      "phases": [
        "test"
      ]
    },
    {
      "alias": "expec",
      "name": "npm:executable-specification-language",
      "version": "0.1.0",
      "phases": [
        "build",
        "runtime"
      ]
    },
    {
      "alias": "vsce",
      "name": "npm:@vscode/vsce",
      "version": "4.0.0",
      "phases": [
        "build"
      ]
    },
    {
      "alias": "vscode-textmate",
      "name": "npm:vscode-textmate",
      "version": "9.3.2",
      "phases": [
        "test"
      ]
    },
    {
      "alias": "vscode-oniguruma",
      "name": "npm:vscode-oniguruma",
      "version": "2.0.1",
      "phases": [
        "test"
      ]
    },
    {
      "alias": "vscode-test-electron",
      "name": "npm:@vscode/test-electron",
      "version": "3.1.0",
      "phases": [
        "test"
      ]
    },
    {
      "alias": "language-client",
      "version": "10.1.2",
      "phases": [
        "runtime"
      ],
      "name": "npm:vscode-languageclient"
    },
    {
      "alias": "language-server",
      "version": "10.1.2",
      "phases": [
        "runtime"
      ],
      "name": "npm:vscode-languageserver"
    },
    {
      "alias": "language-server-document",
      "version": "1.0.15",
      "phases": [
        "runtime"
      ],
      "name": "npm:vscode-languageserver-textdocument"
    }
  ]
}
